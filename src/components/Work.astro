---
import { getSiteData, type Locale } from '../i18n';
import SectionHeader from './SectionHeader.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const data = getSiteData(lang);
const { projects } = data;
const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
const { moreWork } = data.ui;
---

<section id="projetos" class="container-page pb-14 sm:pb-20 md:pb-32">
  <SectionHeader
    index={data.ui.sectionWork.index}
    label={data.ui.sectionWork.label}
    title={data.ui.sectionWork.title}
    titleMuted={data.ui.sectionWork.titleMuted}
    caption={data.ui.sectionWork.caption}
  />

  <div class="mt-16 grid gap-5 md:grid-cols-2">
    {
      featured.map((project) => (
        <a
          href={project.href ?? '#contato'}
          class="group flex flex-col border border-line bg-ink-soft p-4 transition-colors duration-300 hover:border-line-strong"
          data-reveal
          data-reveal-group
        >
          {/* Tags */}
          <div class="mb-3 flex flex-wrap items-center gap-1.5 px-1 pt-1 sm:mb-4 sm:gap-2">
            {project.categories.map((cat) => (
              <span class="mono border border-line px-2 py-0.5 text-[9.5px] uppercase tracking-widest text-mist sm:px-3 sm:py-1 sm:text-[10.5px]">
                {cat}
              </span>
            ))}
            <span class="mono ml-auto text-[10px] text-faint sm:text-[11px]">{project.meta}</span>
          </div>

          {/* Image */}
          {/* Imagem inteira (contain); o que sobrar do 16:10 é preenchido pela própria imagem desfocada */}
          <div class="relative aspect-[16/10] overflow-hidden bg-ink-soft">
            <img
              src={project.image}
              alt=""
              aria-hidden="true"
              loading="lazy"
              class="absolute inset-0 h-full w-full scale-125 object-cover opacity-90 blur-2xl"
            />
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
              class="relative h-full w-full object-contain transition-transform duration-700 group-hover:scale-[1.04]"
            />
            <span
              class="absolute left-0 top-0 h-1 w-full origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100"
              style={`background:${project.accent}`}
            />
          </div>

          {/* Footer */}
          <div class="flex items-start justify-between gap-4 px-1 pb-1 pt-5">
            <div>
              {project.highlight && (
                <p class="mono mb-3 inline-flex items-center gap-2 border border-lime/40 px-2.5 py-1 text-[10.5px] uppercase tracking-widest text-lime">
                  <span class="h-1.5 w-1.5 rounded-full bg-lime" />
                  {project.highlight}
                </p>
              )}
              <h3 class="display text-2xl leading-tight md:text-[1.7rem]">
                {project.title}
              </h3>
              <p class="mt-2 max-w-md text-[14px] leading-relaxed text-mist">
                {project.description}
              </p>
            </div>
            <span class="mt-1 grid h-11 w-11 shrink-0 place-items-center rounded-full border border-line text-mist transition-all duration-300 group-hover:border-cream group-hover:text-cream">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M4 12L12 4M12 4H5M12 4V11"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                ></path>
              </svg>
            </span>
          </div>
        </a>
      ))
    }
  </div>

  {/* Demais cases: lista compacta, uma linha cada */}
  {more.length > 0 && (
    <div class="mt-14 sm:mt-20" data-reveal>
      <h3 class="label">{moreWork.label}</h3>
      <ul class="mt-5 border-t border-line">
        {more.map((project) => (
          <li class="border-b border-line">
            <a
              href={project.href ?? '#contato'}
              class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-5 md:grid-cols-[16rem_1fr_auto]"
            >
              <span class="display text-xl leading-tight transition-colors group-hover:text-lime md:text-2xl">
                {project.title}
              </span>
              <span class="col-span-2 row-start-2 max-w-2xl text-[14px] leading-relaxed text-mist md:col-span-1 md:row-start-auto">
                {project.description}
              </span>
              <span class="mono text-[10.5px] uppercase tracking-widest text-faint">{project.meta}</span>
            </a>
          </li>
        ))}
      </ul>
      <a
        href={moreWork.earlierHref}
        target="_blank"
        rel="noreferrer"
        class="mono link-underline mt-6 inline-block text-[13px] text-mist transition-colors hover:text-cream"
      >
        {moreWork.earlier} →
      </a>
    </div>
  )}
</section>
