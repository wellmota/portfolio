---
/**
 * Página de case editorial, no formato da apresentação da marca Tutory: fundo preto,
 * capítulos numerados, imagens grandes sem moldura de device, dourado só em detalhes.
 */
import { getSiteData, getLocalePath, type Locale } from '../i18n';
import type { BrandCaseContent, BrandImage } from '../data/cases/tutory-brand';

interface Props {
  lang: Locale;
  content: BrandCaseContent;
  /** URL da mesma página no outro idioma */
  altHref: string;
  altLabel: string;
}

const { lang, content: c, altHref, altLabel } = Astro.props;
const data = getSiteData(lang);
const homeHref = getLocalePath(lang);
const projectsHref = getLocalePath(lang, '#projetos');
const contactHref = getLocalePath(lang, '#contato');

const figCols = (n: number) => (n === 3 ? 'grid-cols-1 sm:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2');
---

<div class="brand">
  <header class="b-hairline-b">
    <div class="container-page">
      <nav class="flex items-center justify-between gap-4 py-4">
        <a href={homeHref} class="flex items-center gap-2.5 shrink-0">
          <span class="gothic grid h-8 w-8 place-items-center bg-lime pb-0.5 text-[19px] text-ink">
            {data.profile.firstName.charAt(0)}
          </span>
          <span class="hidden text-[14px] font-semibold tracking-tight sm:inline b-ink">{data.profile.name}</span>
        </a>
        <div class="flex items-center gap-5">
          <a href={projectsHref} class="mono text-[11px] uppercase tracking-widest b-muted transition-colors hover:text-white">
            ← {c.ui.back}
          </a>
          <a
            href={altHref}
            class="mono b-hairline px-3 py-1.5 text-[11px] uppercase tracking-widest b-muted transition-colors hover:border-white/40 hover:text-white"
          >
            {altLabel}
          </a>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <!-- Abertura -->
    <section class="container-page pt-16 sm:pt-24 md:pt-32">
      <p class="mono flex items-center gap-3 text-[11px] uppercase tracking-[.22em] b-muted" data-reveal>
        <span class="b-dot" aria-hidden="true"></span>{c.kicker}
      </p>
      <h1 class="display mt-8 max-w-5xl text-[2.6rem] leading-[1] sm:text-6xl md:text-[5.6rem] b-ink" data-reveal>
        {c.title}
      </h1>
      <p class="mt-8 max-w-2xl text-[17px] leading-relaxed b-muted md:text-[19px]" data-reveal>{c.subtitle}</p>
    </section>

    <!-- Vídeo de abertura, de ponta a ponta -->
    <section class="mt-14 md:mt-20">
      <figure>
        <div class="b-bleed">
          <video
            class="block w-full"
            poster={c.hero.poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={c.hero.alt}
          >
            {c.hero.video.webm && <source src={c.hero.video.webm} type="video/webm" />}
            <source src={c.hero.video.src} type="video/mp4" />
          </video>
        </div>
        <figcaption class="container-page mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <span class="mono text-[11px] uppercase tracking-widest b-muted">00 — {c.hero.caption}</span>
          <span class="mono text-[10px] uppercase tracking-widest b-faint">loop · 1920 × 1080</span>
        </figcaption>
      </figure>
    </section>

    <!-- Ficha -->
    <section class="container-page mt-14 md:mt-20">
      <dl class="grid grid-cols-2 gap-x-8 gap-y-7 b-hairline-t pt-8 sm:grid-cols-3 lg:grid-cols-5" data-reveal>
        {
          c.meta.map((m) => (
            <div>
              <dt class="mono text-[10px] uppercase tracking-widest b-faint">{m.label}</dt>
              <dd class="mt-2 text-[13.5px] leading-snug b-ink">{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Capítulos -->
    {
      c.chapters.map((ch) => (
        <section class="container-page mt-24 md:mt-36">
          <div class="b-hairline-t pt-8 md:grid md:grid-cols-[200px_1fr] md:gap-12 lg:grid-cols-[260px_1fr]">
            <div class="flex items-baseline gap-4 md:block" data-reveal>
              <span class="display block text-5xl leading-none b-num md:text-[5.5rem]">{ch.num}</span>
              <p class="mono text-[11px] uppercase tracking-[.22em] b-gold md:mt-5">{ch.kicker}</p>
            </div>
            <div class="mt-8 md:mt-0">
              <h2 class="display max-w-3xl text-3xl leading-[1.05] sm:text-4xl md:text-[3.2rem] b-ink" data-reveal>
                {ch.title}
              </h2>
              {ch.lead && (
                <p class="mt-8 max-w-3xl text-[22px] font-medium leading-snug b-ink md:text-[28px]" data-reveal>
                  {ch.lead}
                </p>
              )}
              <div class="mt-7 max-w-2xl space-y-5" data-reveal>
                {ch.body.map((p) => (
                  <p class="text-[16px] leading-relaxed b-muted md:text-[17px]">{p}</p>
                ))}
              </div>
            </div>
          </div>

          {ch.blocks?.map((b) => (
            <div class="mt-12 md:mt-16">
              {b.type === 'full' && (
                <figure data-reveal>
                  <img src={b.image.src} alt={b.image.alt} loading="lazy" class="block w-full" />
                  <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    {b.image.label && <span class="mono text-[11px] uppercase tracking-widest b-muted">{b.image.label}</span>}
                    {b.image.meta && <span class="mono text-[10px] uppercase tracking-widest b-faint">{b.image.meta}</span>}
                    {b.image.caption && <span class="mono mt-1 w-full text-[11px] leading-relaxed tracking-wide b-faint">{b.image.caption}</span>}
                  </figcaption>
                </figure>
              )}

              {(b.type === 'pair' || b.type === 'trio') && (
                <div class:list={['grid gap-5 md:gap-6', figCols(b.items.length)]}>
                  {b.items.map((img) => (
                    <figure data-reveal data-reveal-group>
                      <img src={img.src} alt={img.alt} loading="lazy" class="block w-full" />
                      <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        {img.label && <span class="mono text-[11px] uppercase tracking-widest b-muted">{img.label}</span>}
                        {img.meta && <span class="mono text-[10px] uppercase tracking-widest b-faint">{img.meta}</span>}
                        {img.caption && <span class="mono mt-1 w-full text-[11px] leading-relaxed tracking-wide b-faint">{img.caption}</span>}
                      </figcaption>
                    </figure>
                  ))}
                </div>
              )}

              {b.type === 'slides' && (
                <div class="b-strip -mx-[var(--gutter)] flex snap-x snap-mandatory gap-4 overflow-x-auto px-[var(--gutter)] pb-4 md:gap-6">
                  {b.items.map((img) => (
                    <figure class="w-[78vw] shrink-0 snap-start sm:w-[46%] lg:w-[32%]">
                      <img src={img.src} alt={img.alt} loading="lazy" class="block w-full" />
                      <figcaption class="mono mt-3 text-[11px] uppercase tracking-widest b-muted">{img.label}</figcaption>
                    </figure>
                  ))}
                </div>
              )}

              {b.type === 'quote' && (
                <blockquote class="mx-auto max-w-4xl py-6 text-center md:py-10" data-reveal>
                  <span class="b-rule mx-auto block" aria-hidden="true"></span>
                  <p class="display mt-8 text-2xl leading-[1.15] tracking-tight b-ink sm:text-3xl md:text-[2.6rem]">{b.text}</p>
                  {b.by && <footer class="mono mt-6 text-[10px] uppercase tracking-widest b-faint">{b.by}</footer>}
                </blockquote>
              )}

              {b.type === 'voice' && (
                <div class="grid gap-10 b-hairline-t pt-10 md:grid-cols-2 md:gap-16" data-reveal>
                  <div>
                    <p class="mono text-[10px] uppercase tracking-widest b-faint">{b.beforeLabel}</p>
                    <p class="display mt-5 text-2xl leading-tight b-faint sm:text-3xl md:text-[2.4rem]">{b.before}</p>
                  </div>
                  <div>
                    <p class="mono text-[10px] uppercase tracking-widest b-gold">{b.afterLabel}</p>
                    <p class="display mt-5 text-2xl leading-tight b-ink sm:text-3xl md:text-[2.4rem]">{b.after}</p>
                  </div>
                </div>
              )}

              {b.type === 'archetypes' && (
                <div class="grid b-hairline-t md:grid-cols-2" data-reveal>
                  {b.items.map((a, i) => (
                    <div class:list={['py-10 md:py-14', i === 1 ? 'b-hairline-t md:b-hairline-l md:border-t-0 md:pl-14' : 'md:pr-14']}>
                      <p class="mono text-[10px] uppercase tracking-widest b-gold">{a.role}</p>
                      <p class="display mt-5 text-4xl leading-none b-ink md:text-[3.4rem]">{a.name}</p>
                      <p class="mt-5 max-w-sm text-[17px] leading-relaxed b-muted">{a.desc}</p>
                      <p class="mono mt-8 text-[10px] uppercase tracking-widest b-faint">{a.refs}</p>
                    </div>
                  ))}
                </div>
              )}

              {b.type === 'palette' && (
                <div data-reveal>
                  <div class="grid grid-cols-3 gap-4 md:grid-cols-6 md:gap-5">
                    {b.colors.map((col) => (
                      <div>
                        <div
                          class:list={['aspect-[4/5] w-full', col.name === 'Gold' ? 'b-swatch-gold' : 'b-swatch']}
                          style={`background:${col.hex}`}
                        ></div>
                        <p class="mono mt-4 text-[10px] uppercase tracking-widest b-faint">{col.n}</p>
                        <p class="mt-1 text-[15px] font-semibold b-ink">{col.name}</p>
                        <p class="mono mt-1 text-[11px] b-muted">{col.hex}</p>
                        <p class="mono text-[10px] b-faint">{col.rgb}</p>
                      </div>
                    ))}
                  </div>
                  <p class="mono mt-8 text-[11px] uppercase tracking-widest b-gold">{b.note}</p>
                </div>
              )}

              {b.type === 'spec' && (
                <dl class="b-hairline-t" data-reveal>
                  {b.rows.map(([k, v]) => (
                    <div class="grid gap-1 b-hairline-b py-4 sm:grid-cols-[180px_1fr] sm:gap-8">
                      <dt class="mono text-[10px] uppercase tracking-widest b-faint">{k}</dt>
                      <dd class="mono text-[12px] leading-relaxed b-ink">{v}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {b.type === 'evolution' && (
                <div class="grid gap-12 md:grid-cols-2 md:gap-16" data-reveal>
                  {b.columns.map((col, i) => (
                    <div>
                      <p class:list={['mono text-[10px] uppercase tracking-widest', i === 0 ? 'b-faint' : 'b-gold']}>{col.label}</p>
                      <ul class="mt-4">
                        {col.items.map((it) => (
                          <li class:list={['display b-hairline-b py-4 text-2xl leading-none md:text-[2.2rem]', i === 0 ? 'b-faint' : 'b-ink']}>{it}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </section>
      ))
    }

    <!-- Números -->
    <section class="container-page mt-24 md:mt-36">
      <p class="mono text-[11px] uppercase tracking-[.22em] b-gold" data-reveal>{c.statsLabel}</p>
      <div class="mt-6 grid grid-cols-2 b-hairline-t sm:grid-cols-3 lg:grid-cols-6">
        {
          c.stats.map((s) => (
            <div class="b-hairline-b py-6 pr-5 md:py-8" data-reveal data-reveal-group>
              <span class="display block text-4xl b-ink md:text-[2.8rem]">{s.value}</span>
              <span class="mt-3 block text-[12px] leading-snug b-muted">{s.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Resultados + ferramentas -->
    <section class="container-page mt-20 md:mt-28">
      <div class="grid gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
        <div data-reveal>
          <p class="mono text-[11px] uppercase tracking-[.22em] b-gold">{c.outcomesLabel}</p>
          <h2 class="display mt-4 text-3xl leading-tight b-ink sm:text-4xl">{c.outcomesTitle}</h2>
          <ul class="mt-6 space-y-3">
            {
              c.outcomes.map((o) => (
                <li class="flex gap-3 text-[15px] leading-relaxed b-muted">
                  <span class="mt-[2px] shrink-0 b-gold">+</span>
                  {o}
                </li>
              ))
            }
          </ul>
        </div>
        <div data-reveal>
          <p class="mono text-[10px] uppercase tracking-widest b-faint">{c.stackLabel}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {
              c.stack.map((t) => (
                <span class="mono b-hairline px-2.5 py-1 text-[10.5px] uppercase tracking-wider b-muted">{t}</span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Próximo case -->
    <section class="container-page mt-20 md:mt-28">
      <a href={c.next.href} class="b-next group block b-hairline p-7 transition-colors md:p-10" data-reveal>
        <p class="mono text-[10px] uppercase tracking-widest b-gold">{c.next.label}</p>
        <span class="mt-4 flex items-center justify-between gap-6">
          <span class="display text-3xl leading-tight b-ink sm:text-4xl md:text-[2.8rem]">{c.next.title}</span>
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full b-hairline b-muted transition-all group-hover:border-white group-hover:text-white">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </span>
        <p class="mt-3 max-w-xl text-[15px] leading-relaxed b-muted">{c.next.sub}</p>
      </a>
    </section>

    <!-- CTA -->
    <section class="container-page my-20 md:my-28">
      <div class="b-hairline p-8 text-center md:p-14" data-reveal>
        <h2 class="display mx-auto max-w-2xl text-3xl leading-tight b-ink sm:text-4xl">{c.cta.heading}</h2>
        <p class="mx-auto mt-4 max-w-xl text-[15px] leading-relaxed b-muted">{c.cta.sub}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href={contactHref} class="btn btn-solid">
            {c.cta.label}
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href={projectsHref} class="btn b-btn-outline">{c.ui.back}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="b-hairline-t">
    <div class="container-page flex flex-wrap items-center justify-between gap-3 py-6">
      <span class="mono text-[11px] b-faint">{data.footer.legal}</span>
      <span class="mono text-[11px] b-faint">{data.ui.portfolioEdition}</span>
    </div>
  </footer>
</div>

<style>
  .brand {
    --b-ink: #fafaf8;
    --b-muted: rgba(255, 255, 255, 0.58);
    --b-faint: rgba(255, 255, 255, 0.34);
    --b-line: rgba(255, 255, 255, 0.13);
    --b-gold: #c9a96e;
    background: #000;
    color: var(--b-ink);
    overflow-x: clip;
  }
  .b-ink { color: var(--b-ink); }
  .b-muted { color: var(--b-muted); }
  .b-faint { color: var(--b-faint); }
  .b-gold { color: var(--b-gold); }
  .b-num { color: rgba(255, 255, 255, 0.14); }
  .b-hairline { border: 1px solid var(--b-line); }
  .b-hairline-t { border-top: 1px solid var(--b-line); }
  .b-hairline-b { border-bottom: 1px solid var(--b-line); }
  .b-hairline-l { border-left: 1px solid var(--b-line); }
  .b-dot { width: 6px; height: 6px; border-radius: 999px; background: var(--b-gold); flex: none; }
  .b-rule { width: 56px; height: 1px; background: var(--b-gold); }
  .b-bleed { width: 100vw; margin-left: calc(50% - 50vw); background: #000; }
  .b-bleed video { max-height: 100svh; object-fit: cover; margin-inline: auto; }
  .b-swatch { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); }
  .b-swatch-gold { box-shadow: inset 0 0 0 1px rgba(201, 169, 110, 0.9); }
  .b-strip { scrollbar-width: none; }
  .b-strip::-webkit-scrollbar { display: none; }
  .b-next:hover { border-color: var(--b-gold); }
  .b-btn-outline { border-color: rgba(255, 255, 255, 0.28); color: var(--b-ink); }
  .b-btn-outline:hover { border-color: var(--b-ink); background: rgba(255, 255, 255, 0.06); }
  @media (prefers-reduced-motion: reduce) {
    .b-strip { scroll-behavior: auto; }
  }
</style>

<script>
  // Respeita prefers-reduced-motion: o vídeo de abertura fica no poster.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.brand video[autoplay]').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }
</script>
