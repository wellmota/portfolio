---
import { getSiteData, type Locale } from '../i18n';
import SectionHeader from './SectionHeader.astro';
import GithubActivity from './GithubActivity.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const data = getSiteData(lang);
const { articles } = data;
---

<!-- Sem padding no topo: a linha do SectionHeader marca o fim do respiro do FAQ -->
<section id="escrita" class="container-page pb-14 sm:pb-20 md:pb-32">
  <SectionHeader
    index={data.ui.sectionWriting.index}
    label={data.ui.sectionWriting.label}
    title={data.ui.sectionWriting.title}
    titleMuted={data.ui.sectionWriting.titleMuted}
    caption={data.ui.sectionWriting.caption}
  />

  <div class="mt-16 grid items-stretch gap-8 lg:grid-cols-2">
    <!-- Coluna Medium -->
    <div class="flex flex-col" data-reveal>
      <div class="flex-1 border-t border-line">
        {
          articles.map((a, i) => (
            <a
              href={a.href}
              target="_blank"
              rel="noreferrer"
              class="group flex gap-5 border-b border-line py-6 transition-colors hover:bg-ink-soft md:px-3"
            >
              <span class="mono pt-1 text-xs text-faint">
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class="min-w-0 flex-1">
                <h3 class="display text-xl leading-tight transition-colors group-hover:text-cream md:text-2xl">
                  {a.title}
                </h3>
                <p class="mt-2 line-clamp-2 text-[14px] leading-relaxed text-mist">
                  {a.excerpt}
                </p>
                <div class="mono mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[11px] uppercase tracking-widest text-faint">
                  <span>{a.date}</span>
                  <span>{a.source}</span>
                  <span class="text-mist">{a.tag}</span>
                </div>
              </div>

              <span class="grid h-9 w-9 shrink-0 place-items-center self-center border border-line text-mist transition-colors group-hover:border-line-strong group-hover:text-cream">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M4 12L12 4M12 4H5M12 4V11"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-6">
        <a
          href="https://medium.com/@wellingtonmota"
          target="_blank"
          rel="noreferrer"
          class="mono link-underline text-[13px] text-mist transition-colors hover:text-cream"
        >
          Ver todos no Medium →
        </a>
      </div>
    </div>

    <!-- Coluna GitHub -->
    <GithubActivity lang={lang} />
  </div>
</section>
