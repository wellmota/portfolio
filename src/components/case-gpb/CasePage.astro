---
/**
 * Página do case do GPB, o sistema financeiro de um grupo empresarial brasileiro. Mesma estrutura do case do
 * Método OBA (case-oba/CasePage): editorial, cantos retos, linhas de 1px, Inter + JetBrains Mono, sem o
 * global.css do site. A diferença é a paleta, que vem do próprio GPB (ink verde-escuro, paper, teal e
 * latão), e o protótipo: aqui é o app React de verdade, num build estático só de demonstração em
 * /cases/gpb/proto/ (ver ProtoEmbed). Os blocos de antes/depois, telas, vídeo e dados com fonte são os
 * mesmos componentes do case do OBA.
 */
import { getSiteData, getLocalePath, type Locale } from '@/i18n';
import type { CaseBlock, CaseImage, CaseOba, CaseSection } from '@/data/cases/oba-types';
import BeforeAfter from '../case-oba/BeforeAfter.astro';
import Showcase from '../case-oba/Showcase.astro';
import Video from '../case-oba/Video.astro';
import Foil from '../case-oba/Foil.astro';
import ProtoEmbed from './ProtoEmbed.astro';

interface Props {
  lang: Locale;
  content: CaseOba;
  /** URL da mesma página no outro idioma */
  altHref: string;
  altLabel: string;
}

const { lang, content: c, altHref, altLabel } = Astro.props;
const data = getSiteData(lang);
const homeHref = getLocalePath(lang);
const projectsHref = getLocalePath(lang, '#projetos');
const contactHref = getLocalePath(lang, '#contato');

const blocksOf = (s: CaseSection): CaseBlock[] => [...(s.kind === 'text' ? [] : [s]), ...(s.media ?? [])];
const ratio = (img: CaseImage) => `aspect-ratio:${img.width} / ${img.height}`;
const num = (n: number) => String(n).padStart(2, '0');
const temResultado = !!(c.outcomes?.length || c.tools?.length);
---

<!-- Rede de segurança do reveal: o CSS esconde os blocos [data-reveal] enquanto o <html> tem .js. Se o
     script da página não rodar em 4 s (erro, extensão que bloqueia), sai o .js e tudo aparece parado -->
<script is:inline>
  setTimeout(function () {
    if (!window.csRevealPronto) document.documentElement.classList.remove('js');
  }, 4000);
</script>

<div class="oba gpb" style={`--accent:${c.accent};--accent-2:${c.accent2}`}>
  <!-- o mesmo cabeçalho dos outros cases do portfólio (CaseStudyPage), em CSS próprio -->
  <header class="cs-header">
    <nav class="cs-container cs-header__in">
      <a href={homeHref} class="cs-brand">
        <span class="cs-brand__mark" aria-hidden="true">{data.profile.firstName.charAt(0)}</span>
        <span class="cs-brand__label">{data.profile.name}</span>
      </a>
      <div class="cs-nav">
        <a href={projectsHref} class="mono cs-nav__link">← {c.ui.back}</a>
        <a href={altHref} class="mono cs-nav__lang" hreflang={lang === 'pt' ? 'en' : 'pt'}>{altLabel}</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="cs-container cs-hero">
      <p class="cs-kicker" data-reveal>{c.kicker}</p>
      <h1 class="display cs-title" data-reveal>{c.title}</h1>
      <p class="cs-subtitle" data-reveal>{c.subtitle}</p>
      {
        c.heroStat && (
          <aside class="cs-hero__fonte" data-reveal>
            <Foil {...c.heroStat} />
          </aside>
        )
      }

      <dl class="cs-meta" data-reveal>
        {
          c.meta.map((m) => (
            <div>
              <dt class="cs-label">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Capa: o protótipo interativo (o mesmo da seção 02) ou, sem ele, a imagem -->
    {
      c.coverProto ? (
        <ProtoEmbed {...c.coverProto} />
      ) : (
        <section class="cs-container cs-cover-wrap">
          <div class="cs-cover" data-reveal>
            <span class="cs-cover__bar" aria-hidden="true" />
            <img
              src={c.cover.src}
              alt={c.cover.alt}
              width={c.cover.width}
              height={c.cover.height}
              loading="lazy"
              decoding="async"
              style={ratio(c.cover)}
            />
          </div>
        </section>
      )
    }

    <!-- Intro + o que muda (opcionais) -->
    {
      (c.intro?.length || c.roleList?.length) && (
        <section class="cs-container cs-intro">
          <div class="cs-stack" data-reveal>
            {c.intro?.map((p) => (
              <p class="cs-p">{p}</p>
            ))}
          </div>
          <div data-reveal>
            <p class="cs-label">{c.roleLabel}</p>
            <ul class="cs-chips">
              {c.roleList?.map((r) => (
                <li class="mono cs-chip">{r}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Números (opcionais: o case do OBA abre sem eles) -->
    {
      c.stats && c.stats.length > 0 && (
        <section class="cs-container cs-stats-wrap">
          <div class="cs-stats">
            {c.stats.map((s) => (
              <div class="cs-stat" data-reveal data-reveal-group>
                <span class="display cs-stat__value">{s.value}</span>
                <span class="cs-stat__label">{s.label}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Seções -->
    {
      c.sections.map((s, si) => (
        <section class="cs-section" aria-labelledby={`cs-s${si + 1}`}>
          <div class="cs-container cs-sec-topo">
            <div class="cs-sec-head">
              <p class="cs-kicker" data-reveal>
                {s.kicker}
              </p>
              <h2 id={`cs-s${si + 1}`} class="display cs-h2" data-reveal>
                {s.title}
              </h2>
              <div class="cs-stack cs-sec-body" data-reveal>
                {s.body.map((p) => (
                  <p class="cs-p">{p}</p>
                ))}
                {s.live && (
                  <p>
                    <a class="cs-live" href="#prototipo" data-gpb-tela={s.live.screen}>
                      {s.live.label} <span aria-hidden="true">↑</span>
                    </a>
                  </p>
                )}
              </div>
            </div>
            {s.stat && (
              <div class="cs-sec-fonte" data-reveal>
                <Foil {...s.stat} n={num(si + 1)} />
              </div>
            )}
          </div>

          {blocksOf(s).map((b) => (
            <>
              {b.kind === 'image' && (
                <figure class="cs-container cs-block" data-reveal>
                  <div class="cs-frame">
                    <img
                      src={b.image.src}
                      alt={b.image.alt}
                      width={b.image.width}
                      height={b.image.height}
                      loading="lazy"
                      decoding="async"
                      style={ratio(b.image)}
                    />
                  </div>
                  {b.image.caption && <figcaption class="cs-caption">{b.image.caption}</figcaption>}
                </figure>
              )}

              {b.kind === 'gallery' && (
                <div class="cs-container cs-block cs-gallery-linhas">
                  {(b.gallery.rows ?? [{ title: b.gallery.title, items: b.gallery.items ?? [] }]).map((linha) => (
                  <div class="cs-gallery-linha">
                  {linha.title && (
                    <p class="cs-label cs-gallery__title" data-reveal>
                      {linha.title}
                    </p>
                  )}
                  <div
                    class:list={[
                      'cs-gallery',
                      linha.items.every((g) => g.device === 'phone') ? 'cs-gallery--phone' : 'cs-gallery--desktop',
                    ]}
                    style={`--n:${Math.min(linha.items.length, 4)}`}
                  >
                    {linha.items.map((g) => (
                      <div
                        class:list={['cs-shot', g.device === 'phone' ? 'print-ios' : 'cs-shot--desktop']}
                        data-reveal
                        data-reveal-group
                      >
                        <img
                          src={g.src}
                          alt={g.alt}
                          width={g.width}
                          height={g.height}
                          loading="lazy"
                          decoding="async"
                          style={ratio(g)}
                        />
                        {b.gallery.badge && <span class="mono cs-badge">{b.gallery.badge}</span>}
                      </div>
                    ))}
                  </div>
                  </div>
                  ))}
                  {b.gallery.caption && (
                    <p class="cs-caption" data-reveal>
                      {b.gallery.caption}
                    </p>
                  )}
                </div>
              )}

              {b.kind === 'details' && (
                <div class="cs-container cs-block">
                  {b.details.title && (
                    <p class="cs-label cs-gallery__title" data-reveal>
                      {b.details.title}
                    </p>
                  )}
                  <div class="cs-details">
                    {b.details.items.map((d) => (
                      <figure class="cs-detail" data-reveal data-reveal-group>
                        <div class="cs-detail__img">
                          <img
                            src={d.src}
                            alt={d.alt}
                            width={d.width}
                            height={d.height}
                            loading="lazy"
                            decoding="async"
                            style={ratio(d)}
                          />
                        </div>
                        <figcaption class="cs-detail__body">
                          <span class="mono cs-detail__label">{d.label}</span>
                          <p>{d.text}</p>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                </div>
              )}

              {b.kind === 'compare' && <BeforeAfter {...b.compare} />}
              {b.kind === 'showcase' && <Showcase {...b.showcase} />}
              {b.kind === 'prototype' && <ProtoEmbed {...b.prototype} />}
              {b.kind === 'video' && <Video {...b.video} />}
            </>
          ))}
        </section>
      ))
    }

    <!-- Entrega: design engineering (estratégia, protótipo em código, tema no PHP, performance) -->
    {
      c.engenharia && (
        <section class="cs-section cs-eng" aria-labelledby="cs-eng">
          <div class="cs-container">
            <div class="cs-sec-head">
              <p class="cs-kicker" data-reveal>
                {c.engenharia.kicker}
              </p>
              <h2 id="cs-eng" class="display cs-h2" data-reveal>
                {c.engenharia.title}
              </h2>
              <div class="cs-stack cs-sec-body" data-reveal>
                {c.engenharia.body.map((p) => (
                  <p class="cs-p">{p}</p>
                ))}
              </div>
            </div>
            <ol class="cs-eng__grid">
              {c.engenharia.pilares.map((pl, i) => (
                <li class="cs-eng__card" data-reveal data-reveal-group>
                  <div class="cs-eng__topo">
                    <span class="mono cs-eng__n">{num(i + 1)}</span>
                    <h3 class="cs-eng__titulo">{pl.titulo}</h3>
                  </div>
                  <p class="cs-eng__dado">
                    <strong class="display cs-eng__valor">{pl.value}</strong>
                    <span class="mono cs-eng__label">{pl.label}</span>
                  </p>
                  <p class="cs-eng__texto">{pl.texto}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <!-- Resultado + ferramentas (opcionais) -->
    {temResultado && (
    <section class="cs-container cs-outcome">
      <div class="cs-outcome__grid">
        <div data-reveal>
          <p class="cs-kicker">{c.outcomesLabel}</p>
          <h2 class="display cs-h2">{c.outcomesTitle}</h2>
          <ul class="cs-plus">
            {
              c.outcomes?.map((o) => (
                <li>
                  <span aria-hidden="true">+</span>
                  {o}
                </li>
              ))
            }
          </ul>
        </div>
        {
          c.tools && c.tools.length > 0 && (
            <div data-reveal>
              <p class="cs-label">{c.toolsLabel}</p>
              <ul class="cs-chips">
                {c.tools.map((t) => (
                  <li class="mono cs-chip">{t}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>
    )}

    <!-- CTA (o mesmo dos outros cases do portfólio) -->
    <section class="cs-container cs-cta-wrap">
      <div class="cs-cta" data-reveal>
        <h2 class="display cs-cta__t">{c.cta.heading}</h2>
        <p class="cs-cta__p">{c.cta.sub}</p>
        <div class="cs-cta__btns">
          <a href={contactHref} class="mono cs-btn cs-btn--solid">
            {c.cta.label}
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={projectsHref} class="mono cs-btn cs-btn--outline">{c.ui.back}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="cs-footer">
    <div class="cs-container cs-footer__in">
      <span class="mono">{data.footer.legal}</span>
      <span class="mono">{data.ui.portfolioEdition}</span>
    </div>
  </footer>
</div>

<style is:global>
  /* ---------- tokens (os mesmos do portfólio; o accent vem do case) ---------- */
  :root {
    /* a paleta do GPB (src/index.css do app): o ink verde-escuro vira o fundo, o paper vira o texto e as
       faixas claras, o teal clareado para ler no escuro e o latão para os destaques pequenos */
    --ink: #0b1f1d;
    --ink-soft: #0d2422;
    --surface: #112b28;
    --surface-2: #15332f;
    --line: #1f3e3a;
    --line-strong: #31534e;
    --cream: #f7f5f0;
    --mist: #a6b3b0;
    --faint: #82938f;
    --accent: #4fbfaf;
    --accent-2: #e9c27a;
    --lime: #cff24a;
    --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    /* sem a fonte do Google, o Windows cai na Cascadia Mono ou na Consolas (o "monospace" de lá é a
       Courier New); o ui-monospace só existe no Safari */
    --font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, 'Cascadia Mono', Consolas, monospace;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --gutter: 1.25rem;
    color-scheme: dark;
  }
  @media (min-width: 640px) {
    :root {
      --gutter: 1.75rem;
    }
  }
  @media (min-width: 1024px) {
    :root {
      --gutter: 3rem;
    }
  }

  /* ---------- reset mínimo (a página não carrega o preflight do Tailwind) ---------- */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    background: var(--ink);
  }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--cream);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  h1,
  h2,
  h3,
  p,
  dl,
  dd,
  figure,
  blockquote {
    margin: 0;
  }
  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  img,
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }
  iframe {
    display: block;
  }
  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ::selection {
    background: var(--accent);
    color: var(--ink);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ---------- utilidades ---------- */
  .cs-container {
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .display {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .mono {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .cs-kicker {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cs-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .cs-p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--mist);
  }
  @media (min-width: 768px) {
    .cs-p {
      font-size: 16px;
    }
  }
  .cs-stack > * + * {
    margin-top: 1.25rem;
  }
  .cs-caption {
    margin-top: 0.75rem;
    max-width: 48rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--faint);
  }
  .cs-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 1rem;
  }
  .cs-chip {
    border: 1px solid var(--line);
    padding: 4px 10px;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mist);
  }
  .cs-block {
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) {
    .cs-block {
      margin-top: 3.5rem;
    }
  }
  /* imagem sem arquivo (ou carregando): ocupa o espaço com a superfície */
  .oba img {
    background: var(--surface);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* faixa clara de ponta a ponta, com um leve tom do accent */
  .cs-band {
    background: #f7f5f0;
    background:
      radial-gradient(70% 60% at 0% 0%, rgb(15 118 110 / 0.1) 0%, transparent 60%),
      radial-gradient(60% 60% at 100% 100%, rgb(184 134 47 / 0.09) 0%, transparent 60%),
      #f7f5f0;
    color: #0b1f1d;
    color-scheme: light;
  }
  .cs-band img {
    background: #e4e2dc;
    color: #5b6b68;
  }

  /* prints do app novo no celular: cantos arredondados proporcionais à largura. 8% e não os 14% do
     iPhone: o print começa no topo do app, sem a barra de status, e o canto maior cortava o avatar */
  .print-ios {
    container-type: inline-size;
  }
  .print-ios img,
  .print-ios video {
    display: block;
    width: 100%;
    border-radius: 8cqw;
    border: 1px solid var(--line);
  }
  @supports not (border-radius: 1cqw) {
    .print-ios img,
    .print-ios video {
      border-radius: 18px;
    }
  }

  /* ---------- janela de navegador (Showcase, Video e ProtoEmbed) ----------
     medidas em cqw: a barra, os pontos e os cantos acompanham a largura da janela */
  .cs-win-wrap {
    container-type: inline-size;
  }
  .cs-win {
    position: relative;
    border-radius: max(6px, 1.2cqw);
    background: #e9eaee;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.1),
      0 30px 60px rgba(0, 0, 0, 0.28),
      0 8px 18px rgba(0, 0, 0, 0.16);
  }
  .cs-win__bar {
    display: flex;
    align-items: center;
    gap: max(6px, 1cqw);
    height: max(24px, 3.2cqw);
    padding: 0 max(8px, 1.3cqw);
    border-radius: max(6px, 1.2cqw) max(6px, 1.2cqw) 0 0;
    background: linear-gradient(180deg, #f6f6f8, #e9e9ed);
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.08);
  }
  .cs-win__dots {
    display: inline-flex;
    flex: none;
    gap: max(4px, 0.55cqw);
  }
  .cs-win__dots i {
    width: max(7px, 0.95cqw);
    height: max(7px, 0.95cqw);
    border-radius: 50%;
    background: #c8c8cf;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .cs-win__url {
    min-width: 0;
    margin: 0 auto;
    padding: max(2px, 0.38cqw) max(10px, 1.4cqw);
    border-radius: max(4px, 0.5cqw);
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    font-family: var(--font-mono);
    font-size: max(10px, 1.05cqw);
    letter-spacing: 0.02em;
    color: #6a6a70;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cs-win__screen {
    overflow: hidden;
    border-radius: 0 0 max(6px, 1.2cqw) max(6px, 1.2cqw);
    background: #fff;
  }
  .cs-win__screen img,
  .cs-win__screen video {
    width: 100%;
    object-fit: cover;
  }
  @supports not (padding: 1cqw) {
    .cs-win {
      border-radius: 10px;
    }
    .cs-win__bar {
      border-radius: 10px 10px 0 0;
      height: 32px;
      padding: 0 12px;
      gap: 10px;
    }
    .cs-win__dots i {
      width: 10px;
      height: 10px;
    }
    .cs-win__url {
      font-size: 11px;
      padding: 3px 14px;
    }
    .cs-win__screen {
      border-radius: 0 0 10px 10px;
    }
  }

  /* ---------- iPhone (Video e ProtoEmbed): tela 390×844 escalada por --s ----------
     cantos de 32px na tela (e não 54px): o app começa no topo, sem a barra de status */
  .cs-phone {
    --s: 0.86;
    position: relative;
    width: fit-content;
    padding: 11px;
    border-radius: calc(32px * var(--s) + 11px);
    background: linear-gradient(145deg, #1d1d1f 0%, #0a0a0a 55%, #161618 100%);
    box-shadow:
      0 0 0 1px #2a2a2a,
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 50px 90px -20px rgba(20, 20, 40, 0.45),
      0 14px 30px rgba(0, 0, 0, 0.2);
  }
  .cs-phone__screen {
    position: relative;
    width: calc(390px * var(--s));
    overflow: hidden;
    border-radius: calc(32px * var(--s));
    background: #0a0a0a;
    /* Safari: recorta o conteúdo nos cantos arredondados */
    isolation: isolate;
    transform: translateZ(0);
