<script>
  // ---- reveal ao rolar ----------------------------------------------------
  const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (!('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        });
      },
      // threshold 0: as telas do protótipo passam de 1.500 px de altura e, numa tela baixa (notebook
      // com escala de 150%, ~600 px), um bloco assim nunca chegaria a uma fração fixa visível
      { threshold: 0, rootMargin: '0px 0px -10% 0px' }
    );
    revealEls.forEach((el) => {
      // itens de grade entram em cascata, pela posição entre os irmãos
      if (el.hasAttribute('data-reveal-group') && el.parentElement) {
        const i = Array.prototype.indexOf.call(el.parentElement.children, el);
        el.style.setProperty('--reveal-delay', `${(i % 6) * 70}ms`);
      }
      io.observe(el);
    });
  }
  // na impressão (ou "Salvar como PDF") não há rolagem: tudo aparece
  addEventListener('beforeprint', () => revealEls.forEach((el) => el.classList.add('is-visible')));
  // avisa a rede de segurança do topo da página que o reveal está de pé
  (window as Window & { csRevealPronto?: boolean }).csRevealPronto = true;

  // ---- iframes do protótipo: são lazy, mas depois que a página carrega vão sendo carregados um a um,
  // em ordem, para nenhuma tela aparecer em branco numa rolagem rápida ----
  const preCarregar = () => {
    const fila = [...document.querySelectorAll<HTMLIFrameElement>('iframe[loading="lazy"]')];
    const carregado = (f: HTMLIFrameElement) => {
      try {
        const d = f.contentDocument;
        return !!d && d.URL !== 'about:blank' && d.readyState === 'complete';
      } catch {
        return true; // outra origem: o navegador cuida
      }
    };
    const proximo = () => {
      const f = fila.shift();
      if (!f) return;
      if (carregado(f)) return proximo();
      let foi = false;
      const seguir = () => {
        if (foi) return;
        foi = true;
        setTimeout(proximo, 400);
      };
      f.addEventListener('load', seguir, { once: true });
      setTimeout(seguir, 6000); // se o load não vier, segue a fila mesmo assim
      f.loading = 'eager';
    };
    proximo();
  };
  // No celular a fila não roda: são nove protótipos, e lá cada um carrega só quando chega perto da tela
  // (o lazy do navegador), para não gastar o plano de dados de quem só passou pela página
  const agendar = () => setTimeout(preCarregar, 1500);
  if (matchMedia('(min-width: 1024px)').matches) {
    if (document.readyState === 'complete') agendar();
    else addEventListener('load', agendar, { once: true });
  }

  // ---- vídeos em loop: tocam só na tela; com movimento reduzido, param no poster ----
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-loop]')];
  if (videos.length) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const visible = new Set<HTMLVideoElement>();
    const play = (v: HTMLVideoElement) => {
      const p = v.play();
      if (p) p.catch(() => {});
    };
    const still = (v: HTMLVideoElement) => {
      v.autoplay = false;
      v.pause();
      v.controls = true; // quem quiser, dá o play
      v.load(); // volta ao poster
    };
    const apply = () => {
      videos.forEach((v) => {
        if (reduce.matches) return still(v);
        v.controls = false;
        if (visible.has(v)) play(v);
        else v.pause();
      });
    };
    if ('IntersectionObserver' in window) {
      const vio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) visible.add(v);
            else visible.delete(v);
            if (reduce.matches) return;
            if (e.isIntersecting) play(v);
            else v.pause();
          });
        },
        { threshold: 0.15 }
      );
      videos.forEach((v) => vio.observe(v));
    } else {
      videos.forEach((v) => visible.add(v));
    }
    if (reduce.matches) apply();
    reduce.addEventListener?.('change', apply);
    // se o navegador pausar um vídeo que está na tela (ao voltar da aba, ao sair da tela cheia),
    // ele volta a tocar; os que saíram da tela não estão em `visible`
    const retomar = () => {
      if (document.hidden || reduce.matches) return;
      visible.forEach((v) => v.paused && play(v));
    };
    videos.forEach((v) => v.addEventListener('pause', () => setTimeout(retomar, 300)));
    document.addEventListener('visibilitychange', retomar);
    document.addEventListener('fullscreenchange', retomar);
  }
</script>
