---
/**
 * Página do case do Método OBA: a apresentação feita para o cliente (no site da Tutory, em /r/oba),
 * trazida para o portfólio sem a abertura e sem o aviso de celular. Escura, editorial, cantos retos,
 * linhas de 1px, Inter + JetBrains Mono. Não usa o global.css do site: os tokens, o reset e as
 * utilidades da página estão no <style is:global> abaixo. Cada seção tem cabeçalho de texto e
 * blocos de mídia (o principal, pelo `kind`, e os extras de `media`). Cabeçalho, CTA e rodapé
 * seguem os dos outros cases do portfólio.
 */
import { getSiteData, getLocalePath, type Locale } from '@/i18n';
import type { CaseBlock, CaseImage, CaseOba, CaseSection } from '@/data/cases/oba-types';
import BeforeAfter from './BeforeAfter.astro';
import Showcase from './Showcase.astro';
import ProtoEmbed from './ProtoEmbed.astro';
import ProtoTelas from './ProtoTelas.astro';
import Roadmap from './Roadmap.astro';
import Fonte from './Fonte.astro';
import Foil from './Foil.astro';
import EscalaDesenho from './EscalaDesenho.astro';
import Video from './Video.astro';

interface Props {
  lang: Locale;
  content: CaseOba;
  /** URL da mesma página no outro idioma */
  altHref: string;
  altLabel: string;
}

const { lang, content: c, altHref, altLabel } = Astro.props;
const data = getSiteData(lang);
const homeHref = getLocalePath(lang);
const projectsHref = getLocalePath(lang, '#projetos');
const contactHref = getLocalePath(lang, '#contato');

const blocksOf = (s: CaseSection): CaseBlock[] => [...(s.kind === 'text' ? [] : [s]), ...(s.media ?? [])];
const ratio = (img: CaseImage) => `aspect-ratio:${img.width} / ${img.height}`;
const num = (n: number) => String(n).padStart(2, '0');
const temResultado = !!(c.outcomes?.length || c.tools?.length);
// Carimbo do planejamento: o texto repete quantas vezes couber na volta (~54 caracteres), cada um
// centrado no seu arco, com um ponto (círculo, e não um caractere: o ✦ vinha de outra fonte e saía
// torto) entre eles, na altura do meio das maiúsculas (base em r 76 + metade da caixa-alta)
const seloTexto = c.roadmap?.selo?.texto ?? '';
const seloN = Math.max(1, Math.round(54 / (seloTexto.length + 3)));
// o espaço entre as letras estica o texto até fechar o arco (volta de r 76 = 477,5; 22 para o ponto),
// para não sobrar um vão na volta quando o texto cabe uma vez só. A mono avança 0,6em por letra (11,5px)
const seloEspaco = Math.min(5.75, Math.max(1.4, (2 * Math.PI * 76) / seloN / Math.max(1, seloTexto.length) - 22 / Math.max(1, seloTexto.length) - 6.9)).toFixed(2);
const seloArcos = Array.from({ length: seloN }, (_, k) => {
  const a = (k * 2 * Math.PI) / seloN;
  return { meio: `${((k + 0.5) * 100) / seloN}%`, x: (100 - 80.2 * Math.cos(a)).toFixed(2), y: (100 - 80.2 * Math.sin(a)).toFixed(2) };
});
---

<!-- Rede de segurança do reveal: o CSS esconde os blocos [data-reveal] enquanto o <html> tem .js. Se o
     script da página não rodar em 4 s (erro, extensão que bloqueia), sai o .js e tudo aparece parado -->
<script is:inline>
  setTimeout(function () {
    if (!window.csRevealPronto) document.documentElement.classList.remove('js');
  }, 4000);
</script>

<div class="oba" style={`--accent:${c.accent};--accent-2:${c.accent2}`}>
  <!-- o mesmo cabeçalho dos outros cases do portfólio (CaseStudyPage), em CSS próprio -->
  <header class="cs-header">
    <nav class="cs-container cs-header__in">
      <a href={homeHref} class="cs-brand">
        <span class="cs-brand__mark" aria-hidden="true">{data.profile.firstName.charAt(0)}</span>
        <span class="cs-brand__label">{data.profile.name}</span>
      </a>
      <div class="cs-nav">
        <a href={projectsHref} class="mono cs-nav__link">← {c.ui.back}</a>
        <a href={altHref} class="mono cs-nav__lang" hreflang={lang === 'pt' ? 'en' : 'pt'}>{altLabel}</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="cs-container cs-hero">
      <p class="cs-kicker" data-reveal>{c.kicker}</p>
      <h1 class="display cs-title" data-reveal>{c.title}</h1>
      <p class="cs-subtitle" data-reveal>{c.subtitle}</p>
      {
        c.heroStat && (
          <aside class="cs-hero__fonte" data-reveal>
            <Foil {...c.heroStat} />
          </aside>
        )
      }

      <dl class="cs-meta" data-reveal>
        {
          c.meta.map((m) => (
            <div>
              <dt class="cs-label">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Capa: o protótipo interativo (o mesmo da seção 02) ou, sem ele, a imagem -->
    {
      c.coverProto ? (
        <ProtoEmbed {...c.coverProto} />
      ) : (
        <section class="cs-container cs-cover-wrap">
          <div class="cs-cover" data-reveal>
            <span class="cs-cover__bar" aria-hidden="true" />
            <img
              src={c.cover.src}
              alt={c.cover.alt}
              width={c.cover.width}
              height={c.cover.height}
              loading="lazy"
              decoding="async"
              style={ratio(c.cover)}
            />
          </div>
        </section>
      )
    }

    <!-- As telas ao vivo, uma embaixo da outra -->
    {c.telas && <ProtoTelas {...c.telas} />}

    <!-- Intro + o que muda (opcionais) -->
    {
      (c.intro?.length || c.roleList?.length) && (
        <section class="cs-container cs-intro">
          <div class="cs-stack" data-reveal>
            {c.intro?.map((p) => (
              <p class="cs-p">{p}</p>
            ))}
          </div>
          <div data-reveal>
            <p class="cs-label">{c.roleLabel}</p>
            <ul class="cs-chips">
              {c.roleList?.map((r) => (
                <li class="mono cs-chip">{r}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Números (opcionais: o case do OBA abre sem eles) -->
    {
      c.stats && c.stats.length > 0 && (
        <section class="cs-container cs-stats-wrap">
          <div class="cs-stats">
            {c.stats.map((s) => (
              <div class="cs-stat" data-reveal data-reveal-group>
                <span class="display cs-stat__value">{s.value}</span>
                <span class="cs-stat__label">{s.label}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Seções -->
    {
      c.sections.map((s, si) => (
        <section class="cs-section" aria-labelledby={`cs-s${si + 1}`}>
          <div class="cs-container cs-sec-topo">
            <div class="cs-sec-head">
              <p class="cs-kicker" data-reveal>
                {s.kicker}
              </p>
              <h2 id={`cs-s${si + 1}`} class="display cs-h2" data-reveal>
                {s.title}
              </h2>
              <div class="cs-stack cs-sec-body" data-reveal>
                {s.body.map((p) => (
                  <p class="cs-p">{p}</p>
                ))}
                {s.live && (
                  <p>
                    <a class="cs-live" href={`#tela-${s.live.screen}`}>
                      {s.live.label} <span aria-hidden="true">↑</span>
                    </a>
                  </p>
                )}
              </div>
            </div>
            {s.stat && (
              <div class="cs-sec-fonte" data-reveal>
                <Foil {...s.stat} n={num(si + 1)} />
              </div>
            )}
          </div>

          {blocksOf(s).map((b) => (
            <>
              {b.kind === 'image' && (
                <figure class="cs-container cs-block" data-reveal>
                  <div class="cs-frame">
                    <img
                      src={b.image.src}
                      alt={b.image.alt}
                      width={b.image.width}
                      height={b.image.height}
                      loading="lazy"
                      decoding="async"
                      style={ratio(b.image)}
                    />
                  </div>
                  {b.image.caption && <figcaption class="cs-caption">{b.image.caption}</figcaption>}
                </figure>
              )}

              {b.kind === 'gallery' && (
                <div class="cs-container cs-block cs-gallery-linhas">
                  {(b.gallery.rows ?? [{ title: b.gallery.title, items: b.gallery.items ?? [] }]).map((linha) => (
                  <div class="cs-gallery-linha">
                  {linha.title && (
                    <p class="cs-label cs-gallery__title" data-reveal>
                      {linha.title}
                    </p>
                  )}
                  <div
                    class:list={[
                      'cs-gallery',
                      linha.items.every((g) => g.device === 'phone') ? 'cs-gallery--phone' : 'cs-gallery--desktop',
                    ]}
                    style={`--n:${Math.min(linha.items.length, 4)}`}
                  >
                    {linha.items.map((g) => (
                      <div
                        class:list={['cs-shot', g.device === 'phone' ? 'print-ios' : 'cs-shot--desktop']}
                        data-reveal
                        data-reveal-group
                      >
                        <img
                          src={g.src}
                          alt={g.alt}
                          width={g.width}
                          height={g.height}
                          loading="lazy"
                          decoding="async"
                          style={ratio(g)}
                        />
                        {b.gallery.badge && <span class="mono cs-badge">{b.gallery.badge}</span>}
                      </div>
                    ))}
                  </div>
                  </div>
                  ))}
                  {b.gallery.caption && (
                    <p class="cs-caption" data-reveal>
                      {b.gallery.caption}
                    </p>
                  )}
                </div>
              )}

              {b.kind === 'blueprint' && (
                <div class="cs-container cs-block">
                  <ul class="cs-bp__legenda" data-reveal>
                    {b.blueprint.legenda.map((l) => (
                      <li class="mono cs-bp__chave">
                        <span class={`cs-bp__cor cs-bp__cor--${l.cor}`} aria-hidden="true" />
                        {l.texto}
                      </li>
                    ))}
                  </ul>
                  <div class="cs-shot cs-shot--desktop" data-reveal>
                    <img
                      src={b.blueprint.desktop.src}
                      alt={b.blueprint.desktop.alt}
                      width={b.blueprint.desktop.width}
                      height={b.blueprint.desktop.height}
                      loading="lazy"
                      decoding="async"
                      style={ratio(b.blueprint.desktop)}
                    />
                  </div>
                  {b.blueprint.escala && (
                    <div class="cs-bp__escala">
                      {b.blueprint.escala.map((e) => (
                        <div class="cs-bp__carta" data-reveal data-reveal-group>
                          <Foil value={e.value} label={e.label} source={e.source} tipo={e.tipo}>
                            <EscalaDesenho desenho={e.desenho} />
                          </Foil>
                        </div>
                      ))}
                    </div>
                  )}
                  <div class="cs-bp__baixo">
                    <div class="cs-bp__celulares">
                      {b.blueprint.celular.map((g) => (
                        <div class="cs-shot print-ios" data-reveal data-reveal-group>
                          <img
                            src={g.src}
                            alt={g.alt}
                            width={g.width}
                            height={g.height}
                            loading="lazy"
                            decoding="async"
                            style={ratio(g)}
                          />
                        </div>
                      ))}
                    </div>
                    <ol class="cs-bp__defesas">
                      {b.blueprint.defesas.map((d, i) => (
                        <li class="cs-bp__defesa" data-reveal data-reveal-group>
                          <span class="mono cs-bp__n">{String(i + 1).padStart(2, '0')}</span>
                          <h3 class="display cs-bp__titulo">{d.titulo}</h3>
                          <p class="cs-p">{d.texto}</p>
                          {d.stat && <Fonte {...d.stat} />}
                        </li>
                      ))}
                    </ol>
                  </div>
                  {b.blueprint.nota && (
                    <aside class:list={['cs-bp__nota', !b.blueprint.nota.titulo && 'cs-bp__nota--so-texto']} data-reveal>
                      {b.blueprint.nota.titulo && (
                        <div>
                          {b.blueprint.nota.kicker && <p class="cs-kicker">{b.blueprint.nota.kicker}</p>}
                          <p class="display cs-bp__mito">{b.blueprint.nota.titulo}</p>
                        </div>
                      )}
                      <div class="cs-bp__resposta">
                        <div class="cs-stack">
                          {b.blueprint.nota.texto.map((t) => (
                            <p class="cs-p">{t}</p>
                          ))}
                        </div>
                        {b.blueprint.nota.stat && <Fonte {...b.blueprint.nota.stat} />}
                      </div>
                    </aside>
                  )}
                </div>
              )}

              {b.kind === 'details' && (
                <div class="cs-container cs-block">
                  {b.details.title && (
                    <p class="cs-label cs-gallery__title" data-reveal>
                      {b.details.title}
                    </p>
                  )}
                  <div class="cs-details">
                    {b.details.items.map((d) => (
                      <figure class="cs-detail" data-reveal data-reveal-group>
                        <div class="cs-detail__img">
                          <img
                            src={d.src}
                            alt={d.alt}
                            width={d.width}
                            height={d.height}
                            loading="lazy"
                            decoding="async"
                            style={ratio(d)}
                          />
                        </div>
                        <figcaption class="cs-detail__body">
                          <span class="mono cs-detail__label">{d.label}</span>
                          <p>{d.text}</p>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                </div>
              )}

              {b.kind === 'compare' && <BeforeAfter {...b.compare} />}
              {b.kind === 'showcase' && <Showcase {...b.showcase} />}
              {b.kind === 'prototype' && <ProtoEmbed {...b.prototype} />}
              {b.kind === 'video' && <Video {...b.video} />}
            </>
          ))}
        </section>
      ))
    }

    {
      c.roadmap && (
        <section class="cs-section" aria-labelledby="cs-roadmap">
          <div class="cs-container">
            <div class="cs-rm-head">
              <div class="cs-sec-head">
                <p class="cs-kicker" data-reveal>
                  {c.roadmap.kicker}
                </p>
                <h2 id="cs-roadmap" class="display cs-h2" data-reveal>
                  {c.roadmap.title}
                </h2>
                {c.roadmap.body && (
                  <div class="cs-stack cs-sec-body" data-reveal>
                    <p class="cs-p">{c.roadmap.body}</p>
                  </div>
                )}
              </div>
              {c.roadmap.selo && (
                <div class="cs-selo" data-reveal role="img" aria-label={c.roadmap.selo.texto}>
                  <svg class="cs-selo__anel" viewBox="0 0 200 200" aria-hidden="true">
                    <defs>
                      <path id="cs-selo-arco" d="M100 100m-76 0a76 76 0 1 1 152 0a76 76 0 1 1-152 0" />
                    </defs>
                    <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 4" opacity="0.55" />
                    <circle cx="100" cy="100" r="58" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
                    {seloArcos.map((a) => (
                      <text class="mono cs-selo__texto" text-anchor="middle" style={`letter-spacing:${seloEspaco}px`}>
                        <textPath href="#cs-selo-arco" startOffset={a.meio}>
                          {seloTexto}
                        </textPath>
                      </text>
                    ))}
                    {seloArcos.map((a) => (
                      <circle cx={a.x} cy={a.y} r="1.5" />
                    ))}
                  </svg>
                  <svg class="cs-selo__logo" viewBox="16.2 17.2 61.4 66.6" aria-hidden="true">
                    <path d="M24.6,34.74l-7.68,4.01v21.47l7.71,4.91v7.53c0,.12.06.24.17.3l18.7,10.15c.24.14.54-.03.54-.3V18.25c0-.26-.28-.43-.51-.32l-18.89,8.44c-.12.06-.2.19-.2.32l.17,8.03h0ZM40.46,23.46v53c0,.28-.3.45-.54.3l-11.56-5.81c-.11-.06-.17-.18-.17-.3v-4.57l4.74.23-5.29-3.5h0l-7.16-4.55v-17.35l4.19-2.19c.05,2.6.12,6.02.12,6.25.13.05,5.87,3.44,6.24,3.59,0,0-2.71-5.4-2.71-5.4l-.12-6.28h0l-.02-.99v-.11h0l-.15-6.88c0-.14.07-.26.2-.32l12.22-5.11h0Z" />
                    <path d="M69.45,28.24l-18.84-10.23c-.24-.14-.54.03-.54.3v64.55c0,.26.28.43.51.32l18.89-8.44c.12-.06.2-.19.2-.32l-.17-8.03,7.68-4.01v-21.47l-7.71-4.91v-7.73l-.02-.02ZM73.61,42.85v17.35l-4.19,2.19c-.05-2.6-.12-6.02-.12-6.25-.13-.05-5.99-1.67-6.36-1.82,0,0,2.83,3.63,2.83,3.63l.12,6.28h0l.02,1.09h0s.15,6.89.15,6.89c0,.14-.07.26-.2.32l-11.7,4.85c-.24.12-.51-.05-.51-.32V24.66c0-.28.3-.45.54-.3l11.56,5.81c.11.06.17.18.17.3v4.62l-5.03-1.2,5.03,4.06h0l.65.42h0l7.05,4.49h0Z" />
                  </svg>
                </div>
              )}
            </div>
            <Roadmap steps={c.roadmap.steps} />
          </div>
        </section>
      )
    }

    <!-- Entrega: design engineering (estratégia, protótipo em código, tema no PHP, performance) -->
    {
      c.engenharia && (
        <section class="cs-section cs-eng" aria-labelledby="cs-eng">
          <div class="cs-container">
            <div class="cs-sec-head">
              <p class="cs-kicker" data-reveal>
                {c.engenharia.kicker}
              </p>
              <h2 id="cs-eng" class="display cs-h2" data-reveal>
                {c.engenharia.title}
              </h2>
              <div class="cs-stack cs-sec-body" data-reveal>
                {c.engenharia.body.map((p) => (
                  <p class="cs-p">{p}</p>
                ))}
              </div>
            </div>
            <ol class="cs-eng__grid">
              {c.engenharia.pilares.map((pl, i) => (
                <li class="cs-eng__card" data-reveal data-reveal-group>
                  <div class="cs-eng__topo">
                    <span class="mono cs-eng__n">{num(i + 1)}</span>
                    <h3 class="cs-eng__titulo">{pl.titulo}</h3>
                  </div>
                  <p class="cs-eng__dado">
                    <strong class="display cs-eng__valor">{pl.value}</strong>
                    <span class="mono cs-eng__label">{pl.label}</span>
                  </p>
                  <p class="cs-eng__texto">{pl.texto}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <!-- Resultado + ferramentas (opcionais) -->
    {temResultado && (
    <section class="cs-container cs-outcome">
      <div class="cs-outcome__grid">
        <div data-reveal>
          <p class="cs-kicker">{c.outcomesLabel}</p>
          <h2 class="display cs-h2">{c.outcomesTitle}</h2>
          <ul class="cs-plus">
            {
              c.outcomes?.map((o) => (
                <li>
                  <span aria-hidden="true">+</span>
                  {o}
                </li>
              ))
            }
          </ul>
        </div>
        {
          c.tools && c.tools.length > 0 && (
            <div data-reveal>
              <p class="cs-label">{c.toolsLabel}</p>
              <ul class="cs-chips">
                {c.tools.map((t) => (
                  <li class="mono cs-chip">{t}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>
    )}

    <!-- CTA (o mesmo dos outros cases do portfólio) -->
    <section class="cs-container cs-cta-wrap">
      <div class="cs-cta" data-reveal>
        <h2 class="display cs-cta__t">{c.cta.heading}</h2>
        <p class="cs-cta__p">{c.cta.sub}</p>
        <div class="cs-cta__btns">
          <a href={contactHref} class="mono cs-btn cs-btn--solid">
            {c.cta.label}
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={projectsHref} class="mono cs-btn cs-btn--outline">{c.ui.back}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="cs-footer">
    <div class="cs-container cs-footer__in">
      <span class="mono">{data.footer.legal}</span>
      <span class="mono">{data.ui.portfolioEdition}</span>
    </div>
  </footer>
</div>

<style is:global>
  /* ---------- tokens (os mesmos do portfólio; o accent vem do case) ---------- */
  :root {
    --ink: #0a0a0a;
    --ink-soft: #0d0d0d;
    --surface: #101010;
    --surface-2: #151515;
    --line: #232323;
    --line-strong: #3a3a3a;
    --cream: #ededed;
    --mist: #8c8c92;
    --faint: #6b6b72;
    --accent: #4d7cff;
    --accent-2: #fec133;
    --lime: #cff24a;
    --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    /* sem a fonte do Google, o Windows cai na Cascadia Mono ou na Consolas (o "monospace" de lá é a
       Courier New); o ui-monospace só existe no Safari */
    --font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, 'Cascadia Mono', Consolas, monospace;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --gutter: 1.25rem;
    color-scheme: dark;
  }
  @media (min-width: 640px) {
    :root {
      --gutter: 1.75rem;
    }
  }
  @media (min-width: 1024px) {
    :root {
      --gutter: 3rem;
    }
  }

  /* ---------- reset mínimo (a página não carrega o preflight do Tailwind) ---------- */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    background: var(--ink);
  }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--cream);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
