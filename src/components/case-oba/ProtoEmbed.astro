---
/**
 * Protótipo navegável do painel do aluno sobre a faixa clara (porte do PrototypeEmbed do portfólio).
 *
 * Um iframe só (`?embed=1`: o protótipo esconde o próprio painel de tema). Ele nunca é recarregado
 * nem movido no DOM: trocar Desktop/Celular muda só o tamanho e a escala.
 *  - Desktop: janela de navegador; o iframe roda em 1440×900 e é escalado por `--s` para caber na
 *    largura da janela (ResizeObserver); a altura do recorte é 900 × s.
 *  - Celular: iPhone; o iframe roda em 390×844 com `--s` ≈ .86 (menor em telas estreitas ou baixas).
 *
 * Contrato com o protótipo (postMessage, alvo '*'):
 *  - envia { oba: 'tema', tema: 'cozy' | 'tatico', modo: 'auto' | 'claro' | 'escuro' }
 *  - envia { oba: 'menu', menu: 'a' | 'b' } (o case não tem mais o seletor: o menu vem da tela, e é o B)
 *  - envia { oba: 'estado', estado } (painel, grupo-plano, compartilhar, menu, streak, semana…)
 *  - recebe { oba: 'pronto' } quando o protótipo carrega, e reenvia o estado atual (tema + menu + estado).
 * Telas: atalhos numerados (como no protótipo do golf) que levam o iframe a um estado. O tour automático
 * passa por elas enquanto o protótipo está na tela; pausa com o mouse em cima, com a aba escondida ou
 * fora da tela, para no primeiro clique e não roda com movimento reduzido. Os links "Ver no protótipo"
 * das outras seções ([data-oba-tela]) também chamam uma tela e rolam até aqui.
 * Estado inicial: a 1ª tela. O poster fica por cima até o iframe carregar.
 * A página pode ter mais de um (o do topo e o da seção 02): cada um tem o seu `id`, e um link
 * [data-oba-tela] só mexe no protótipo para onde o `href` aponta.
 */
import type { ProtoBlock } from '@/data/cases/oba-types';
import Marcado from './Marcado.astro';
import PatenteRail from './PatenteRail.astro';
import { ui } from './ui';

type Props = ProtoBlock & { id?: string };

const { id = 'prototipo', src, title, poster, url, hint, dica, openLabel, screensLabel, screens, autoplay, caption } = Astro.props;
const tx = ui(Astro.currentLocale);
const embedSrc = `${src}${src.includes('?') ? '&' : '?'}embed=1`;

const DEVICES = [
  { id: 'desktop', label: tx.desktop },
  { id: 'phone', label: tx.phone },
];
const THEMES = [
  { id: 'cozy', label: tx.themes.cozy, tema: 'cozy', modo: 'auto' },
  { id: 'tatico-escuro', label: tx.themes['tatico-escuro'], tema: 'tatico', modo: 'escuro' },
  { id: 'tatico-claro', label: tx.themes['tatico-claro'], tema: 'tatico', modo: 'claro' },
];
const PATENTE_INICIAL = 'recruta';
const first = screens[0];
const initial = { device: first?.device ?? 'desktop', theme: first?.theme ?? 'tatico-escuro', menu: first?.menu ?? 'b' };
const uid = `pe-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="cs-band cs-block pe"
  id={id}
  data-oba-proto
  data-device={initial.device}
  data-theme={initial.theme}
  data-menu={initial.menu}
  data-estado={first?.estado ?? 'painel'}
  data-patente={PATENTE_INICIAL}
  data-screens={JSON.stringify(screens)}
  data-hold={autoplay ? String(autoplay.hold) : undefined}
>
  <div class="cs-container pe-in">
    <div class="pe-controls" data-reveal>
      <div class="pe-group" role="group" aria-labelledby={`${uid}-dev`}>
        <span class="pe-group__label" id={`${uid}-dev`}>{tx.viewIn}</span>
        <div class="pe-seg">
          {
            DEVICES.map((d) => (
              <button type="button" class="pe-btn" data-set-device={d.id} aria-pressed={d.id === initial.device ? 'true' : 'false'}>
                {d.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="pe-group" role="group" aria-labelledby={`${uid}-tema`}>
        <span class="pe-group__label" id={`${uid}-tema`}>{tx.theme}</span>
        <div class="pe-seg">
          {
            THEMES.map((t) => (
              <button
                type="button"
                class="pe-btn"
                data-set-theme={t.id}
                data-tema={t.tema}
                data-modo={t.modo}
                aria-pressed={t.id === initial.theme ? 'true' : 'false'}
              >
                {t.label}
              </button>
            ))
          }
        </div>
      </div>
      {
        dica && (
          <span class="pe-dica" aria-hidden="true">
            <svg class="pe-dica__mouse" viewBox="0 0 24 24">
              <path d="M14 4.1 12 6" />
              <path d="m5.1 8-2.9-.8" />
              <path d="m6 12-1.9 2" />
              <path d="M7.2 2.2 8 5.1" />
              <path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z" />
            </svg>
            <Marcado texto={dica} />
            <svg class="cs-seta-fina pe-dica__seta" viewBox="0 0 64 52">
              <path pathLength="1" d="M58 6C34 4 14 14 10 46" />
              <path class="pe-dica__ponta" pathLength="1" d="M4.6 39.8L10 46l4.4-6.9" />
            </svg>
          </span>
        )
      }
      <a href={src} target="_blank" rel="noopener" class="pe-btn pe-full" data-pe-full data-src={src}>
        {openLabel} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="pe-layout">
      <div class="pe-stage cs-win-wrap" data-pe-stage data-reveal>
        <PatenteRail id={`${uid}-cor`} inicial={PATENTE_INICIAL} />
        <div class="pe-frame cs-win" data-pe-frame>
          <span class="pe-only-phone cs-phone__btn cs-phone__btn--a" aria-hidden="true"></span>
          <span class="pe-only-phone cs-phone__btn cs-phone__btn--b" aria-hidden="true"></span>
          <span class="pe-only-phone cs-phone__btn cs-phone__btn--side" aria-hidden="true"></span>
          <div class="pe-only-desktop cs-win__bar" aria-hidden="true">
            <span class="cs-win__dots"><i></i><i></i><i></i></span>
            <span class="cs-win__url">{url}</span>
          </div>
          <div class="pe-viewport cs-win__screen" data-pe-viewport>
            <iframe src={embedSrc} title={title} loading="lazy" data-pe-iframe></iframe>
            <img
              class="pe-poster"
              src={poster.src}
              alt={poster.alt}
              width={poster.width}
              height={poster.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <div class="pe-info" data-reveal>
        <div>
          {hint && <p class="pe-hint">{hint}</p>}
        </div>
        {screens.length > 1 && (
        <div>
          <p class="pe-group__label" id={`${uid}-telas`}>{screensLabel}</p>
          <ol class="pe-screens" aria-labelledby={`${uid}-telas`}>
            {
              screens.map((t, i) => (
                <li>
                  <button type="button" class="pe-screen" data-pe-screen={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                    <span class="pe-screen__n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="pe-screen__label">{t.label}</span>
                    {t.meta && <span class="pe-screen__meta">{t.meta}</span>}
                    <span class="pe-screen__bar" aria-hidden="true" />
                  </button>
                </li>
              ))
            }
          </ol>
          {caption && <p class="pe-caption">{caption}</p>}
        </div>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .pe-in {
    padding-block: 2.5rem;
  }
  /* controles, palco e texto na mesma coluna de até 78rem */
  .pe-controls,
  .pe-layout {
    max-width: 78rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .pe-in {
      padding-block: 4rem;
    }
  }

  /* ---------- controles ---------- */
  .pe-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem 1.75rem;
    margin-bottom: 1.75rem;
  }
  .pe-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
  }
  .pe-group__label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5f5f66;
  }
  .pe-seg {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: rgba(255, 255, 255, 0.55);
  }
  .pe-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1 1 auto;
    min-height: 36px;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #3a3a40;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .pe-btn + .pe-btn {
    box-shadow: -1px 0 0 rgba(0, 0, 0, 0.14);
  }
  .pe-btn:hover {
    background: rgba(0, 0, 0, 0.06);
    color: #141414;
  }
  .pe-btn[aria-pressed='true'] {
    background: #141414;
    color: #fff;
  }
  .pe-btn[aria-pressed='true']::before {
    content: '';
    width: 6px;
    height: 6px;
    flex: none;
    background: var(--accent);
  }
  .pe-btn:focus-visible {
    outline: 2px solid #141414;
    outline-offset: 2px;
    position: relative;
    z-index: 1;
  }
  /* a cor da patente (PatenteRail) vira uma coluna à esquerda do palco quando sobra margem */
  @media (min-width: 1420px) {
    .pe-stage {
      position: relative;
    }
  }

  /* tela cheia: abre o protótipo sozinho numa aba nova, no tema escolhido */
  /* ---------- dica acima da janela: ícone do mouse, texto e uma seta fina que desce da esquerda do
     texto até a borda da janela (a ponta fica ~2 px acima dela). Só no modo Desktop: no celular o
     aparelho fica no meio e a seta apontaria para o vazio. A seta se desenha quando os controles
     aparecem ---------- */
  .pe-dica {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-end;
    min-height: 44px;
    margin-left: auto;
    color: #141414;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }
  .pe:not([data-device='desktop']) .pe-dica {
    opacity: 0;
    visibility: hidden;
  }
  /* abaixo de 1024 px os controles empilham e a seta atravessava o "Tela cheia" até a janela */
  @media (max-width: 1023.98px) {
    .pe-dica {
      display: none;
    }
  }
  .pe-dica + .pe-full {
    margin-left: 0;
  }
  .pe-dica__mouse {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pe-dica :global(.cs-anota) {
    white-space: nowrap;
  }
  .pe-dica__seta {
    position: absolute;
    top: calc(50% + 4px);
    left: -4rem;
    width: 4rem;
    height: 3.25rem;
    overflow: visible;
  }
  .pe-dica__seta path {
    stroke-width: 1.5;
  }
  :global(.js) .pe-dica__seta path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.8s var(--ease) 0.9s;
  }
  :global(.js) .pe-dica__seta .pe-dica__ponta {
    transition-delay: 1.65s;
    transition-duration: 0.3s;
  }
  :global(.js) .pe-controls.is-visible .pe-dica__seta path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .pe-dica__seta path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
  .pe-full {
    flex: none;
    margin-left: auto;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: #141414;
    color: #fff;
  }
  .pe-full:hover {
    background: #2a2a2a;
    color: #fff;
  }
  @media (max-width: 640px) {
    .pe-full {
      margin-left: 0;
    }
  }

  /* ---------- palco ---------- */
  .pe-layout {
    display: grid;
    gap: 1.75rem;
  }
  .pe-stage {
    min-width: 0;
  }
  .pe[data-device='desktop'] .pe-frame {
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
  }
  .pe[data-device='phone'] .pe-frame {
    margin-inline: auto;
  }
  .pe[data-device='desktop'] .pe-only-phone,
  .pe[data-device='phone'] .pe-only-desktop {
    display: none;
  }

  .pe-viewport {
    position: relative;
    overflow: hidden;
  }
  /* desktop: a janela mostra a página inteira do protótipo (altura = altura do documento × s), sem
     rolagem interna; antes de medir, fica em 900 (a proporção do poster) */
  .pe[data-device='desktop'] .pe-viewport {
    width: 100%;
    height: calc(var(--h, 900px) * var(--s, 0.5));
    transition: height 0.35s var(--ease);
  }
  .pe[data-device='phone'] .pe-viewport {
    height: calc(844px * var(--s));
  }
  .pe-viewport iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1440px;
    height: var(--h, 900px);
    max-width: none;
    border: 0;
    background: #fff;
    transform: scale(var(--s, 0.5));
    transform-origin: 0 0;
  }
  .pe[data-device='phone'] .pe-viewport iframe {
    width: 390px;
    height: 844px;
  }
  /* poster por cima até o iframe carregar */
  .pe-poster {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    pointer-events: none;
    transition:
      opacity 0.45s ease,
      visibility 0.45s;
  }
  .pe.is-loaded .pe-poster {
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .pe-poster {
      transition: none;
    }
  }

  /* ---------- texto ---------- */
  .pe-info {
    display: grid;
    gap: 1.75rem;
    max-width: 78rem;
    width: 100%;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .pe[data-device='desktop'] .pe-info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }
  /* celular em tela larga: o iPhone de um lado, o texto do outro */
  @media (min-width: 1024px) {
    .pe[data-device='phone'] .pe-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      align-items: center;
      gap: 3rem;
    }
    .pe[data-device='phone'] .pe-info {
      margin-inline: 0;
    }
  }
  .pe-hint {
    font-size: 14.5px;
    line-height: 1.6;
    color: #3a3a40;
  }
  .pe-link {
    display: inline-block;
    margin-top: 1rem;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.3);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #141414;
    transition: border-color 0.2s;
  }
  .pe-link:hover {
    border-color: #141414;
  }
  .pe-link:focus-visible {
    outline: 2px solid #141414;
    outline-offset: 3px;
  }
  /* telas: atalhos numerados; a barra de baixo mostra o tempo do tour na tela atual */
  .pe-screens {
    margin-top: 0.75rem;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }
  .pe-screen {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    width: 100%;
    min-height: 44px;
    padding: 0.7rem 0.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    text-align: left;
    font-size: 14.5px;
    line-height: 1.4;
    color: #3a3a40;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .pe-screen:hover {
    background: rgba(0, 0, 0, 0.04);
    color: #141414;
  }
  .pe-screen:focus-visible {
    outline: 2px solid #141414;
    outline-offset: 2px;
  }
  .pe-screen__n {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: #8a8a90;
  }
  .pe-screen__label {
    flex: 1;
  }
  .pe-screen__meta {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a6a70;
  }
  .pe-screen[aria-pressed='true'] {
    color: #141414;
    font-weight: 600;
  }
  .pe-screen[aria-pressed='true'] .pe-screen__n {
    color: #141414;
  }
  .pe-screen__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: #141414;
    transform: scaleX(var(--p, 0));
    transform-origin: 0 50%;
    opacity: 0;
  }
  .pe.is-touring .pe-screen[aria-pressed='true'] .pe-screen__bar {
    opacity: 1;
  }
  .pe-caption {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    color: #5f5f66;
  }
</style>

<script>
  import { alturaProto, observarProto } from './alturaProto';

  type Device = 'desktop' | 'phone';
  const SIZE: Record<Device, { w: number; h: number; max: number }> = {
    desktop: { w: 1440, h: 900, max: 1 },
    phone: { w: 390, h: 844, max: 0.86 },
  };

  document.querySelectorAll<HTMLElement>('[data-oba-proto]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-pe-stage]');
    const frame = root.querySelector<HTMLElement>('[data-pe-frame]');
    const viewport = root.querySelector<HTMLElement>('[data-pe-viewport]');
    const iframe = root.querySelector<HTMLIFrameElement>('[data-pe-iframe]');
    if (!stage || !frame || !viewport || !iframe) return;

    type Screen = {
      id: string;
      label: string;
      device: Device;
      theme: string;
      menu?: string;
      estado: string;
    };
    const screens: Screen[] = JSON.parse(root.dataset.screens || '[]');
    const screenBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-pe-screen]')];
    const deviceBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-set-device]')];
    const themeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-set-theme]')];
    const menuBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-set-menu]')];

    const press = (btns: HTMLButtonElement[], hit: HTMLButtonElement) =>
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b === hit)));

    // ---- mensagens para o protótipo ----
    const post = (msg: Record<string, string>) => {
      try {
        iframe.contentWindow?.postMessage(msg, '*');
      } catch {
        /* iframe ainda sem documento */
      }
    };
    const full = root.querySelector<HTMLAnchorElement>('[data-pe-full]');
    const sendTheme = () => {
      const b = themeBtns.find((x) => x.dataset.setTheme === root.dataset.theme);
      if (!b) return;
      const tema = b.dataset.tema ?? 'tatico';
      const modo = b.dataset.modo ?? 'escuro';
      post({ oba: 'tema', tema, modo });
      fullHref();
    };
    // a tela cheia abre no mesmo tema e na mesma patente
    const fullHref = () => {
      const b = themeBtns.find((x) => x.dataset.setTheme === root.dataset.theme);
      if (full && b)
        full.href = `${full.dataset.src}?tema=${b.dataset.tema}&modo=${b.dataset.modo}&patente=${root.dataset.patente}`;
    };
    const sendMenu = () => post({ oba: 'menu', menu: root.dataset.menu ?? 'b' });
    const sendEstado = () => post({ oba: 'estado', estado: root.dataset.estado ?? 'painel' });
    const sendPatente = () => post({ oba: 'patente', patente: root.dataset.patente ?? 'recruta' });
    const sendAll = () => {
      sendTheme();
      sendMenu();
      sendPatente();
      sendEstado();
    };

    // ---- escala: desktop cabe na largura da janela; celular ≈ .86, menor em tela estreita ou baixa ----
    const fit = () => {
      const device = (root.dataset.device as Device) ?? 'desktop';
      const { w, h, max } = SIZE[device];
      let s: number;
      if (device === 'desktop') {
        s = viewport.clientWidth / w;
      } else {
        const pad = parseFloat(getComputedStyle(frame).paddingLeft) || 11;
        const byWidth = (stage.clientWidth - pad * 2 - 8) / w;
        const byHeight = (window.innerHeight * 0.92 - pad * 2) / h;
        s = Math.min(max, byWidth, Math.max(0.55, byHeight));
      }
      if (!Number.isFinite(s) || s <= 0) return;
      frame.style.setProperty('--s', s.toFixed(4));
    };

    // ---- desktop: a janela cresce até a altura da página do protótipo (sem rolagem interna) ----
    // Só funciona na mesma origem; fora dela fica em 900 (ver alturaProto.ts).
    let roDoc: ResizeObserver | null = null;
    const medir = () => {
      if (root.dataset.device !== 'desktop') return;
      const h = alturaProto(iframe);
      if (h) frame.style.setProperty('--h', `${h}px`);
    };
    const observarDoc = () => {
      roDoc?.disconnect();
      roDoc = observarProto(iframe, medir);
      medir();
    };

    const setDevice = (device: Device) => {
      root.dataset.device = device;
      const desktop = device === 'desktop';
      // a mesma moldura vira janela de navegador ou iPhone; o iframe não sai do lugar
      frame.classList.toggle('cs-win', desktop);
      frame.classList.toggle('cs-phone', !desktop);
      viewport.classList.toggle('cs-win__screen', desktop);
      viewport.classList.toggle('cs-phone__screen', !desktop);
      fit();
      medir();
    };

    // ---- telas: device + tema + menu + estado de uma vez ----
    const pressBy = (btns: HTMLButtonElement[], key: string, val: string | undefined) => {
      const hit = btns.find((x) => x.dataset[key] === val);
      if (hit) press(btns, hit);
    };
    const applyScreen = (t: Screen) => {
      pressBy(screenBtns, 'peScreen', t.id);
      const mudouDevice = root.dataset.device !== t.device;
      pressBy(deviceBtns, 'setDevice', t.device);
      setDevice(t.device);
      pressBy(themeBtns, 'setTheme', t.theme);
      root.dataset.theme = t.theme;
      if (t.menu) {
        pressBy(menuBtns, 'setMenu', t.menu);
        root.dataset.menu = t.menu;
      }
      root.dataset.estado = t.estado;
      sendTheme();
      sendMenu();
      // depois de trocar o aparelho, o iframe precisa de um quadro para assumir o tamanho novo
      if (mudouDevice) setTimeout(sendEstado, 350);
      else sendEstado();
    };

    // ---- tour automático pelas telas ----
    const hold = Number(root.dataset.hold || 0);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let touring = hold > 0 && !reduce && screens.length > 1;
    let idx = 0;
    let elapsed = 0;
    let last = 0;
    let paused = false;
    let visible = false;
    let ready = false;
    const bar = () => screenBtns[idx]?.querySelector<HTMLElement>('.pe-screen__bar');
    const stopTour = () => {
      if (!touring) return;
      touring = false;
      root.classList.remove('is-touring');
      screenBtns.forEach((b) => b.querySelector<HTMLElement>('.pe-screen__bar')?.style.removeProperty('--p'));
    };
    const loop = (now: number) => {
      if (!touring) return;
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      if (ready && visible && !paused && !document.hidden) elapsed += dt;
      bar()?.style.setProperty('--p', Math.min(1, elapsed / hold).toFixed(3));
      if (elapsed >= hold) {
        bar()?.style.removeProperty('--p');
        idx = (idx + 1) % screens.length;
        elapsed = 0;
        applyScreen(screens[idx]);
      }
      requestAnimationFrame(loop);
    };
    if (touring) {
      root.classList.add('is-touring');
      requestAnimationFrame(loop);
      stage.addEventListener('pointerenter', () => (paused = true));
      stage.addEventListener('pointerleave', () => (paused = false));
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.35 }).observe(stage);
      } else visible = true;
      // clicar dentro do protótipo tira o foco da página: é interação, o tour para
      window.addEventListener('blur', () => {
        if (document.activeElement === iframe) stopTour();
      });
      root.querySelector('.pe-controls')?.addEventListener('click', stopTour);
    }

    screenBtns.forEach((b, i) =>
      b.addEventListener('click', () => {
        stopTour();
        idx = i;
        applyScreen(screens[i]);
      })
    );
    // "Ver no protótipo" nas outras seções
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLElement>('[data-oba-tela]');
      if (!a || a.getAttribute('href') !== `#${root.id}`) return;
      const i = screens.findIndex((t) => t.id === a.dataset.obaTela);
      if (i < 0) return;
      e.preventDefault();
      stopTour();
      idx = i;
      applyScreen(screens[i]);
      root.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });

    deviceBtns.forEach((b) =>
      b.addEventListener('click', () => {
        press(deviceBtns, b);
        setDevice((b.dataset.setDevice as Device) ?? 'desktop');
      })
    );
    themeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        press(themeBtns, b);
        root.dataset.theme = b.dataset.setTheme;
        sendTheme();
      })
    );
    const corBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-set-patente]')];
    corBtns.forEach((b) =>
      b.addEventListener('click', () => {
        stopTour();
        press(corBtns, b);
        root.dataset.patente = b.dataset.setPatente;
        sendPatente();
        fullHref();
      })
    );
    menuBtns.forEach((b) =>
      b.addEventListener('click', () => {
        press(menuBtns, b);
        root.dataset.menu = b.dataset.setMenu;
        sendMenu();
      })
    );

    // ---- carregamento: tira o poster e manda o estado ----
    const loaded = () => {
      ready = true;
      root.classList.add('is-loaded');
      observarDoc();
    };
    const hasDoc = () => {
      try {
        const href = iframe.contentWindow?.location.href;
        return !!href && href !== 'about:blank';
      } catch {
        return true; // outra origem: já é o protótipo
      }
    };
    iframe.addEventListener('load', () => {
      if (!hasDoc()) return;
      loaded();
      sendAll();
    });
    window.addEventListener('message', (e) => {
      if (e.source !== iframe.contentWindow) return;
      const data = e.data as { oba?: unknown } | null;
      if (data && typeof data === 'object' && data.oba === 'pronto') {
        loaded();
        sendAll();
      }
    });
    // o iframe pode ter carregado antes deste script
    try {
      if (hasDoc() && iframe.contentDocument?.readyState === 'complete') {
        loaded();
        sendAll();
      }
    } catch {
      /* outra origem: espera o 'pronto' */
    }

    setDevice((root.dataset.device as Device) ?? 'desktop');
    if ('ResizeObserver' in window) new ResizeObserver(fit).observe(stage);
    window.addEventListener('resize', fit, { passive: true });

    // Dica acima da janela: a seta vai do texto até 3 px da borda de cima da janela, qualquer que
    // seja o layout (abaixo de 1420 px a fileira de patentes fica entre os controles e a janela)
    const dica = root.querySelector<HTMLElement>('.pe-dica');
    const seta = dica?.querySelector<SVGSVGElement>('.pe-dica__seta');
    if (dica && seta && frame) {
      const [corpo, ponta] = Array.from(seta.querySelectorAll('path'));
      // o reveal desce o bloco 22 px até ele aparecer; a medida tira esse deslocamento, senão a ponta
      // fica comprida e entra atrás da janela quando ela sobe
      const deslocamento = (el: Element) => {
        const bloco = el.closest('[data-reveal]');
        const t = bloco ? getComputedStyle(bloco).transform : 'none';
        return t && t !== 'none' ? new DOMMatrixReadOnly(t).m42 : 0;
      };
      const ajustarSeta = () => {
        const d = dica.getBoundingClientRect();
        if (!d.height) return;
        const topoJanela = frame.getBoundingClientRect().top - deslocamento(frame);
        const meioDica = d.top - deslocamento(dica) + d.height / 2;
        const h = Math.max(30, Math.round(topoJanela - 3 - (meioDica + 4)));
        seta.setAttribute('viewBox', `0 0 64 ${h}`);
        seta.style.height = `${h}px`;
        corpo.setAttribute('d', `M58 6C34 4 14 ${Math.round(h * 0.27)} 10 ${h}`);
        ponta.setAttribute('d', `M4.6 ${h - 6.2}L10 ${h}l4.4-6.9`);
      };
      ajustarSeta();
      if ('ResizeObserver' in window) new ResizeObserver(ajustarSeta).observe(root);
      document.fonts?.ready.then(ajustarSeta);
    }
  });
</script>
