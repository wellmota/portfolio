---
/**
 * Prints de desktop em destaque dentro de um device genérico (moldura escura com cantos
 * arredondados e botões laterais, como um tablet largo) sobre um painel claro. A tela do
 * device assume o aspect ratio do print — nada é cortado nem esticado. `size: 'half'`
 * põe dois devices lado a lado no desktop; o padrão ocupa a largura toda.
 */
import type { ShowcaseItem } from '../data/cases/types';

interface Props {
  items: ShowcaseItem[];
  accent: string;
  url?: string;
  start?: number;
  /** 'flat' = print sem moldura de device: só cantos arredondados e sombra sobre a faixa. */
  frame?: 'device' | 'flat';
}

const { items, accent, start = 0, frame = 'device' } = Astro.props;
---

<!-- faixa clara de ponta a ponta: quebra o preto da página; o grid por dentro volta à largura do container -->
<div class="sc-band mt-10 md:mt-14" style={`--sc-accent:${accent}`}>
<div class="container-page grid gap-8 py-10 md:grid-cols-2 md:gap-10 md:py-16">
  {
    items.map((it, i) => (
      <figure class:list={[it.size === 'half' ? 'md:col-span-1' : 'md:col-span-2']} data-reveal>
        <div class="mb-3 flex items-baseline justify-between gap-4">
          <span class="mono text-[11px] uppercase tracking-widest text-sc-ink">
            {String(i + 1 + start).padStart(2, '0')} — {it.label}
          </span>
          {it.meta && <span class="mono text-[10px] uppercase tracking-widest text-sc-muted">{it.meta}</span>}
        </div>
        <div class="sc-panel">
          <div class={frame === 'flat' ? 'sc-flat' : 'sc-device'}>
            {frame !== 'flat' && (
              <>
                <span class="sc-btn sc-btn--top-a" aria-hidden="true" />
                <span class="sc-btn sc-btn--top-b" aria-hidden="true" />
                <span class="sc-btn sc-btn--side" aria-hidden="true" />
              </>
            )}
            <div class={frame === 'flat' ? 'sc-flat-screen' : 'sc-screen'}>
              {it.video ? (
                <video class="block w-full" poster={it.src} autoplay muted loop playsinline preload="metadata" aria-label={it.alt}>
                  {it.video.webm && <source src={it.video.webm} type="video/webm" />}
                  <source src={it.video.src} type="video/mp4" />
                </video>
              ) : (
                <img src={it.src} alt={it.alt} loading="lazy" class="block w-full" />
              )}
            </div>
          </div>
        </div>
        {it.caption && <figcaption class="mono mt-3 text-[11px] leading-relaxed tracking-wide text-sc-muted">{it.caption}</figcaption>}
      </figure>
    ))
  }
</div>
</div>

<style>
  /* faixa clara de ponta a ponta (100vw, centrada), com um leve tom do accent do case */
  .sc-band {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background:
      radial-gradient(90% 70% at 10% 0%, color-mix(in srgb, var(--sc-accent) 10%, #f3f3f3) 0%, transparent 55%),
      linear-gradient(180deg, #f1f1f1 0%, #e4e4e4 100%);
  }
  .text-sc-ink { color: #141414; }
  .text-sc-muted { color: #6a6a70; }
  /* cada device apoia direto na faixa: sem painel próprio, só a sombra */
  .sc-panel {
    container-type: inline-size;
  }
  .sc-device {
    position: relative;
    padding: 2.1cqw;
    border-radius: 3.4cqw;
    background: linear-gradient(145deg, #1c1c1c 0%, #0a0a0a 55%, #141414 100%);
    box-shadow:
      0 0 0 1px #2a2a2a,
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 36px 70px rgba(0, 0, 0, 0.38),
      0 10px 22px rgba(0, 0, 0, 0.25);
  }
  .sc-screen {
    overflow: hidden;
    border-radius: 1.9cqw;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  /* sem device: o print apoia direto na faixa, só cantos e sombra */
  .sc-flat {
    position: relative;
    border-radius: 1.2cqw;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.1),
      0 30px 60px rgba(0, 0, 0, 0.28),
      0 8px 18px rgba(0, 0, 0, 0.16);
  }
  .sc-flat-screen {
    overflow: hidden;
    border-radius: 1.2cqw;
    background: #000;
  }
  /* botões: duas barras na borda superior, uma lateral à direita */
  .sc-btn {
    position: absolute;
    background: #262626;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .sc-btn--top-a,
  .sc-btn--top-b {
    top: -0.45cqw;
    height: 0.45cqw;
    width: 4.5cqw;
    border-radius: 0.3cqw 0.3cqw 0 0;
  }
  .sc-btn--top-a {
    left: 70%;
  }
  .sc-btn--top-b {
    left: 78%;
    width: 7cqw;
  }
  .sc-btn--side {
    right: -0.45cqw;
    top: 22%;
    width: 0.45cqw;
    height: 9cqw;
    border-radius: 0 0.3cqw 0.3cqw 0;
  }
  @supports not (padding: 1cqw) {
    .sc-device { padding: 22px; border-radius: 36px; }
    .sc-screen { border-radius: 20px; }
    .sc-btn { display: none; }
  }
</style>
