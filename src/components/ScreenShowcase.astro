---
/**
 * Prints de desktop em destaque dentro de um device genérico (moldura escura com cantos
 * arredondados e botões laterais, como um tablet largo) sobre um painel claro. A tela do
 * device assume o aspect ratio do print — nada é cortado nem esticado. `size: 'half'`
 * põe dois devices lado a lado no desktop; o padrão ocupa a largura toda.
 */
import type { ShowcaseItem } from '../data/cases/types';

interface Props {
  items: ShowcaseItem[];
  accent: string;
  url?: string;
}

const { items, accent } = Astro.props;
---

<div class="mt-10 grid gap-8 md:grid-cols-2 md:gap-10" style={`--sc-accent:${accent}`}>
  {
    items.map((it, i) => (
      <figure class:list={[it.size === 'half' ? 'md:col-span-1' : 'md:col-span-2']} data-reveal>
        <div class="mb-3 flex items-baseline justify-between gap-4">
          <span class="mono text-[11px] uppercase tracking-widest text-cream">
            {String(i + 1).padStart(2, '0')} — {it.label}
          </span>
          {it.meta && <span class="mono text-[10px] uppercase tracking-widest text-faint">{it.meta}</span>}
        </div>
        <div class="sc-panel">
          <div class="sc-device">
            <span class="sc-btn sc-btn--top-a" aria-hidden="true" />
            <span class="sc-btn sc-btn--top-b" aria-hidden="true" />
            <span class="sc-btn sc-btn--side" aria-hidden="true" />
            <div class="sc-screen">
              <img src={it.src} alt={it.alt} loading="lazy" class="block w-full" />
            </div>
          </div>
        </div>
        {it.caption && <figcaption class="mono mt-3 text-[11px] leading-relaxed tracking-wide text-faint">{it.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  /* painel claro, como num shot de apresentação; o device escuro ganha contraste no site escuro */
  .sc-panel {
    container-type: inline-size;
    padding: clamp(18px, 4vw, 56px) clamp(18px, 4.5vw, 64px);
    border: 1px solid var(--color-line);
    background:
      radial-gradient(110% 90% at 15% 0%, color-mix(in srgb, var(--sc-accent) 9%, #f1f1f1) 0%, transparent 60%),
      linear-gradient(180deg, #ececec 0%, #d9d9d9 100%);
  }
  .sc-device {
    position: relative;
    padding: 2.1cqw;
    border-radius: 3.4cqw;
    background: linear-gradient(145deg, #1c1c1c 0%, #0a0a0a 55%, #141414 100%);
    box-shadow:
      0 0 0 1px #2a2a2a,
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 36px 70px rgba(0, 0, 0, 0.38),
      0 10px 22px rgba(0, 0, 0, 0.25);
  }
  .sc-screen {
    overflow: hidden;
    border-radius: 1.9cqw;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  /* botões: duas barras na borda superior, uma lateral à direita */
  .sc-btn {
    position: absolute;
    background: #262626;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .sc-btn--top-a,
  .sc-btn--top-b {
    top: -0.45cqw;
    height: 0.45cqw;
    width: 4.5cqw;
    border-radius: 0.3cqw 0.3cqw 0 0;
  }
  .sc-btn--top-a {
    left: 70%;
  }
  .sc-btn--top-b {
    left: 78%;
    width: 7cqw;
  }
  .sc-btn--side {
    right: -0.45cqw;
    top: 22%;
    width: 0.45cqw;
    height: 9cqw;
    border-radius: 0 0.3cqw 0.3cqw 0;
  }
  @supports not (padding: 1cqw) {
    .sc-device { padding: 22px; border-radius: 36px; }
    .sc-screen { border-radius: 20px; }
    .sc-btn { display: none; }
  }
</style>
