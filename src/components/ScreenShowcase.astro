---
/**
 * Prints de desktop em destaque sobre uma faixa clara. Três molduras:
 *  - `device` (padrão): moldura escura com cantos arredondados e botões laterais, como um tablet largo;
 *  - `flat`: só cantos arredondados e sombra;
 *  - `browser`: janela de navegador com barra, três pontos e a URL do showcase (ou do item).
 * A tela assume o aspect ratio do print — nada é cortado nem esticado — exceto itens com `scroll`,
 * que ganham uma janela 16:10 e rolam até o fim da página no hover (ou foco, no teclado/toque).
 * `size: 'half'` põe dois lado a lado no desktop; o padrão ocupa a largura toda.
 */
import type { ShowcaseItem } from '../data/cases/types';

interface Props {
  items: ShowcaseItem[];
  accent: string;
  url?: string;
  start?: number;
  frame?: 'device' | 'flat' | 'browser';
}

const { items, accent, url, start = 0, frame = 'device' } = Astro.props;
const screenClass = frame === 'flat' ? 'sc-flat-screen' : frame === 'browser' ? 'sc-browser-screen' : 'sc-screen';
const frameClass = frame === 'flat' ? 'sc-flat' : frame === 'browser' ? 'sc-browser' : 'sc-device';
---

<!-- faixa clara de ponta a ponta: quebra o preto da página; o grid por dentro volta à largura do container -->
<div class="sc-band mt-10 md:mt-14" style={`--sc-accent:${accent}`}>
<div class="container-page grid gap-8 py-10 md:grid-cols-2 md:gap-10 md:py-16">
  {
    items.map((it, i) => (
      <figure class:list={[it.size === 'half' ? 'md:col-span-1' : 'md:col-span-2']} data-reveal>
        <div class="mb-3 flex items-baseline justify-between gap-4">
          <span class="mono text-[11px] uppercase tracking-widest text-sc-ink">
            {String(i + 1 + start).padStart(2, '0')} — {it.label}
          </span>
          {it.meta && <span class="mono text-[10px] uppercase tracking-widest text-sc-muted">{it.meta}</span>}
        </div>
        <div class="sc-panel">
          <div class={frameClass}>
            {frame === 'device' && (
              <>
                <span class="sc-btn sc-btn--top-a" aria-hidden="true" />
                <span class="sc-btn sc-btn--top-b" aria-hidden="true" />
                <span class="sc-btn sc-btn--side" aria-hidden="true" />
              </>
            )}
            {frame === 'browser' && (
              <div class="sc-bar" aria-hidden="true">
                <span class="sc-dots"><i /><i /><i /></span>
                <span class="sc-url">{it.url ?? url ?? ''}</span>
              </div>
            )}
            <div
              class:list={[screenClass, it.scroll && 'sc-scroll']}
              style={it.scroll && it.scrollSeconds ? `--sc-dur:${it.scrollSeconds}s` : undefined}
              tabindex={it.scroll ? 0 : undefined}
            >
              {it.video ? (
                <video class="block w-full" poster={it.src} autoplay muted loop playsinline preload="metadata" aria-label={it.alt}>
                  {it.video.webm && <source src={it.video.webm} type="video/webm" />}
                  <source src={it.video.src} type="video/mp4" />
                </video>
              ) : (
                <img src={it.src} alt={it.alt} loading="lazy" class="block w-full" />
              )}
            </div>
          </div>
        </div>
        {it.caption && <figcaption class="mono mt-3 text-[11px] leading-relaxed tracking-wide text-sc-muted">{it.caption}</figcaption>}
      </figure>
    ))
  }
</div>
</div>

<style>
  /* faixa clara de ponta a ponta (100vw, centrada), com um leve tom do accent do case */
  .sc-band {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background:
      radial-gradient(90% 70% at 10% 0%, color-mix(in srgb, var(--sc-accent) 10%, #f3f3f3) 0%, transparent 55%),
      linear-gradient(180deg, #f1f1f1 0%, #e4e4e4 100%);
  }
  .text-sc-ink { color: #141414; }
  .text-sc-muted { color: #6a6a70; }
  /* cada device apoia direto na faixa: sem painel próprio, só a sombra */
  .sc-panel {
    container-type: inline-size;
  }
  .sc-device {
    position: relative;
    padding: 2.1cqw;
    border-radius: 3.4cqw;
    background: linear-gradient(145deg, #1c1c1c 0%, #0a0a0a 55%, #141414 100%);
    box-shadow:
      0 0 0 1px #2a2a2a,
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 36px 70px rgba(0, 0, 0, 0.38),
      0 10px 22px rgba(0, 0, 0, 0.25);
  }
  .sc-screen {
    overflow: hidden;
    border-radius: 1.9cqw;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  /* sem device: o print apoia direto na faixa, só cantos e sombra */
  .sc-flat,
  .sc-browser {
    position: relative;
    border-radius: 1.2cqw;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.1),
      0 30px 60px rgba(0, 0, 0, 0.28),
      0 8px 18px rgba(0, 0, 0, 0.16);
  }
  .sc-flat-screen {
    overflow: hidden;
    border-radius: 1.2cqw;
    background: #000;
  }
  /* janela de navegador: barra clara com três pontos e a URL centralizada */
  .sc-browser {
    background: #e9eaee;
  }
  .sc-bar {
    display: flex;
    align-items: center;
    gap: 1cqw;
    height: 3.2cqw;
    padding: 0 1.3cqw;
    border-radius: 1.2cqw 1.2cqw 0 0;
    background: linear-gradient(180deg, #f6f6f8, #e9e9ed);
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.08);
  }
  .sc-dots {
    display: inline-flex;
    gap: 0.55cqw;
  }
  .sc-dots i {
    width: 0.95cqw;
    height: 0.95cqw;
    border-radius: 50%;
    background: #c8c8cf;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .sc-url {
    margin: 0 auto;
    min-width: 38%;
    padding: 0.38cqw 1.4cqw;
    border-radius: 0.5cqw;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    font-family: var(--font-mono);
    font-size: max(10px, 1.05cqw);
    letter-spacing: 0.02em;
    color: #6a6a70;
    text-align: center;
    white-space: nowrap;
  }
  .sc-browser-screen {
    overflow: hidden;
    border-radius: 0 0 1.2cqw 1.2cqw;
    background: #fff;
  }
  /* página inteira: janela 16:10 que rola até o fim no hover/foco; a duração vem do item */
  .sc-scroll {
    position: relative;
    aspect-ratio: 16 / 10;
    container-type: size;
    cursor: ns-resize;
    outline: none;
  }
  .sc-scroll img {
    will-change: transform;
    transition: transform var(--sc-dur, 8s) cubic-bezier(0.45, 0, 0.2, 1);
  }
  .sc-scroll:hover img,
  .sc-scroll:focus img,
  .sc-scroll:focus-within img {
    transform: translateY(calc(100cqh - 100%));
  }
  .sc-scroll:focus-visible {
    box-shadow: inset 0 0 0 2px var(--sc-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-scroll img {
      transition: none;
    }
  }
  /* botões: duas barras na borda superior, uma lateral à direita */
  .sc-btn {
    position: absolute;
    background: #262626;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .sc-btn--top-a,
  .sc-btn--top-b {
    top: -0.45cqw;
    height: 0.45cqw;
    width: 4.5cqw;
    border-radius: 0.3cqw 0.3cqw 0 0;
  }
  .sc-btn--top-a {
    left: 70%;
  }
  .sc-btn--top-b {
    left: 78%;
    width: 7cqw;
  }
  .sc-btn--side {
    right: -0.45cqw;
    top: 22%;
    width: 0.45cqw;
    height: 9cqw;
    border-radius: 0 0.3cqw 0.3cqw 0;
  }
  @supports not (padding: 1cqw) {
    .sc-device { padding: 22px; border-radius: 36px; }
    .sc-screen { border-radius: 20px; }
    .sc-btn { display: none; }
    .sc-bar { height: 34px; padding: 0 14px; gap: 10px; }
    .sc-dots i { width: 10px; height: 10px; }
    .sc-url { font-size: 11px; padding: 4px 14px; }
    .sc-scroll img { transition: none; }
    .sc-scroll:hover img { transform: none; }
  }
</style>
