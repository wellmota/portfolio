---
/**
 * Documento para páginas que trazem o próprio CSS (tokens, reset e utilidades) e não podem carregar o
 * global.css do site: o preflight do Tailwind mexe em svg, títulos e listas. Mesmo SEO e analytics do
 * Layout. Hoje só o case do Método OBA usa.
 */
import AnalyticsHead from '../components/AnalyticsHead.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getSiteData, type Locale } from '../i18n';
import { SITE, baseGraph, pageGraph, graphScript } from '../lib/seo';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Caminho (relativo à raiz do site) da OG image da página */
  ogImage: string;
  ogImageAlt: string;
  ogImageWidth: number;
  ogImageHeight: number;
  /** Caminhos da mesma página em cada idioma, para o hreflang */
  alternates: { en: string; pt: string };
  themeColor?: string;
}

const { lang, title, description, ogImageAlt, ogImageWidth, ogImageHeight, alternates, themeColor = '#0a0a0a' } =
  Astro.props;
const data = getSiteData(lang);
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';

const siteUrl = SITE;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}${Astro.props.ogImage}`;
const graph = graphScript([
  ...baseGraph(lang),
  ...pageGraph({ lang, pathname: Astro.url.pathname, title, description, image: ogImage }),
]);
---

<!doctype html>
<html lang={htmlLang} data-locale={lang}>
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={data.profile.name} />

    <link rel="alternate" hreflang="en" href={`${siteUrl}${alternates.en}`} />
    <link rel="alternate" hreflang="pt" href={`${siteUrl}${alternates.pt}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternates.en}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={htmlLang} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={data.profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content={themeColor} />

    <script type="application/ld+json" is:inline set:html={graph} />

    <!-- Fonts (a UnifrakturCook é só a inicial do cabeçalho) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=UnifrakturCook:wght@700&display=swap"
      rel="stylesheet"
    />

    <AnalyticsHead />
  </head>
  <body>
    <slot />

    <ConsentBanner />
  </body>
</html>
