---
import Layout from '../../../layouts/Layout.astro';
import CaseStudyPage from '../../../components/CaseStudyPage.astro';
import finby from '../../../data/cases/finby';

const lang = 'pt' as const;
const content = finby[lang];
---

<Layout
  lang={lang}
  title={content.seo.title}
  description={content.seo.description}
  ogImage={content.cover.src}
  ogImageAlt={content.cover.alt}
  ogImageWidth={1600}
  ogImageHeight={1000}
  alternates={false}
>
  <CaseStudyPage lang={lang} content={content} altHref="/work/finby" altLabel="EN" />
</Layout>
