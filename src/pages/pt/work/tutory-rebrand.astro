---
import Layout from '../../../layouts/Layout.astro';
import BrandCasePage from '../../../components/BrandCasePage.astro';
import tutoryBrand from '../../../data/cases/tutory-brand';

const lang = 'pt' as const;
const content = tutoryBrand[lang];
---

<Layout
  lang={lang}
  title={content.seo.title}
  description={content.seo.description}
  ogImage={content.cover.src}
  ogImageAlt={content.cover.alt}
  ogImageWidth={1600}
  ogImageHeight={1000}
  alternates={false}
>
  <BrandCasePage lang={lang} content={content} altHref="/work/tutory-rebrand/" altLabel="EN" />
</Layout>
